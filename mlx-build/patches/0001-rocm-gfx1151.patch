+int moe_max_run_length_sync(
+    CommandEncoder& encoder,
+    const array& expert_ids,
+    int T,
+    int E) {
+  if (T <= 0 || E <= 0)
+    return 32;
+  // Scalar int32 on device (shape {1} — empty Shape{} not always constructible).
+  array max_run({1}, int32, nullptr, {});
+  max_run.set_data(rocm::malloc_async(sizeof(int), encoder));
+  encoder.add_temporary(max_run);
+  moe_max_run_length(encoder, expert_ids, max_run, T, E);
+
+  static thread_local int* pin = nullptr;
+  if (!pin) {
+    if (hipHostMalloc(
+            reinterpret_cast<void**>(&pin), sizeof(int), hipHostMallocDefault) !=
+        hipSuccess) {
+      throw std::runtime_error("moe_max_run_length_sync: hipHostMalloc failed");
+    }
+  }
+  hipStream_t hs = static_cast<hipStream_t>(encoder.stream());
+  if (hipMemcpyAsync(
+          pin,
+          gpu_ptr<const int>(max_run),
+          sizeof(int),
+          hipMemcpyDeviceToHost,
+          hs) != hipSuccess) {
+    throw std::runtime_error("moe_max_run_length_sync: D2H failed");
+  }
+  if (hipStreamSynchronize(hs) != hipSuccess) {
+    throw std::runtime_error("moe_max_run_length_sync: sync failed");
+  }
+  int m = *pin;
+  if (m < 1)
+    m = 1;
+  if (m > T)
+    m = T;
+  m = (m + 31) & ~31;
+  if (m < 32)
+    m = 32;
+  return m;
+}
+
+namespace {
+
+int align32_clamp(int m, int T) {
+  if (m < 1)
+    m = 1;
+  if (m > T)
+    m = T;
+  m = (m + 31) & ~31;
+  if (m < 32)
+    m = 32;
+  if (m > T)
+    m = (T + 31) & ~31;
+  if (m < 32)
+    m = 32;
+  return m;
+}
+
+// Heuristic: 2× average tokens/expert (sorted MoE rarely worse). No GPU sync.
+int moe_pack_m_pad_heuristic(int T, int E) {
+  if (T <= 0)
+    return 32;
+  if (E <= 0)
+    E = 1;
+  int avg = (T + E - 1) / E;
+  int m = avg * 2;
+  if (m < 64)
+    m = 64;
+  return align32_clamp(m, T);
+}
+
+} // namespace
+
+int moe_pack_m_pad(
+    CommandEncoder& encoder,
+    const array& expert_ids,
+    int T,
+    int E) {
+  if (T <= 0 || E <= 0)
+    return 32;
+
+  static const int pad_mode = [] {
+    // 0 = heuristic only (no sync)
+    // 1 = cache max-run (default) — one sync per (T,E)
+    // 2 = always sync
+    const char* e = std::getenv("MLX_ROCM_MOE_PAD_SYNC");
+    if (!e || !*e)
+      return 1;
+    if (e[0] == '0' || e[0] == 'n' || e[0] == 'N' || e[0] == 'f' || e[0] == 'F')
+      return 0;
+    if (e[0] == 'a' || e[0] == 'A' || e[0] == '2') // always
+      return 2;
+    return 1;
+  }();
+
+  if (pad_mode == 0)
+    return moe_pack_m_pad_heuristic(T, E);
+  if (pad_mode == 2)
+    return moe_max_run_length_sync(encoder, expert_ids, T, E);
+
+  // Cached exact max-run (+12.5% slack). First call for this (T,E) syncs once;
+  // later MoE layers in the same step reuse without StreamSynchronize.
+  // rocprof showed ~150 syncs/step from uncached max_run — this kills that.
+  // Re-measure every kRemeasureCalls hits. The key is (T,E) only, so for a
+  // fixed geometry this cache holds a SINGLE entry that would otherwise be
+  // measured once at process start and frozen forever. Routing imbalance is
+  // not static: as the router specializes, an expert's max run grows past the
+  // first measurement, tokens overflow M_fixed, and moe_pack_kernel silently
+  // drops them (rate climbing over a run). Periodic re-measure lets the cache
+  // follow that drift; the sync cost is amortized to ~1 per kRemeasureCalls
+  // (vs ~150/step uncached, which is what the cache was added to kill).
+  constexpr uint64_t kRemeasureCalls = 512;
+  static std::mutex mu;
+  struct Cached {
+    int m;
+    uint64_t calls;
+  };
+  static std::unordered_map<uint64_t, Cached> cache;
+  const uint64_t key = (static_cast<uint64_t>(static_cast<uint32_t>(T)) << 32) |
+      static_cast<uint32_t>(E);
+  {
+    std::lock_guard<std::mutex> g(mu);
+    auto it = cache.find(key);
+    if (it != cache.end() && (++it->second.calls % kRemeasureCalls) != 0)
+      return it->second.m; // fall through on the Nth call to re-measure
+  }
+  int measured = moe_max_run_length_sync(encoder, expert_ids, T, E);
+  int floor_h = moe_pack_m_pad_heuristic(T, E);
+  // max(measured, 2×avg) + 25% slack. Grow-only, and re-measured every
+  // kRemeasureCalls so the cache follows routing drift instead of freezing at
+  // the step-0 measurement. NOTE: a drop is NOT benign on every path — the
+  // fused forward (moe_swiglu.cpp) used to leave dropped rows unwritten, which
+  // surfaced recycled memory (NaN). That path now memsets, so a drop costs a
+  // zeroed token rather than a NaN — still a real quality loss, hence the
+  // re-measure.
+  int m = measured > floor_h ? measured : floor_h;
+  m = align32_clamp(m + m / 4, T);
+  {
+    std::lock_guard<std::mutex> g(mu);
+    auto it = cache.find(key);
+    uint64_t calls = 0;
+    if (it != cache.end()) {
+      calls = it->second.calls;
+      if (it->second.m > m)
+        m = it->second.m; // grow-only: never shrink into a drop
+    }
+    cache[key] = Cached{m, calls};
+  }
+  return m;
+}
+
+// ---------------------------------------------------------------------------
+// MoE pack workspace — single bump slab, stream-ordered free on grow.
+//
+// Earlier grow-only path *retired* old slabs forever (untracked hipMalloc) →
+// VRAM filled to 100% + GTT spill. Now:
+//   - size to exact need (+2MiB page align), no 50% capacity bloat
+//   - hipMallocAsync / hipFreeAsync on the eval stream (ordered free)
+//   - one live base; free previous on grow after prior work on that stream
+// ---------------------------------------------------------------------------
+namespace {
+
+struct MoeWs {
+  std::mutex mu;
+  void* base{nullptr};
+  size_t capacity{0};
+  size_t offset{0};
+  int device{-1};
+};
+
+MoeWs& moe_ws() {
+  static MoeWs* w = new MoeWs;
+  return *w;
+}
+
+size_t align_up_256(size_t n) {
+  return (n + 255) & ~size_t(255);
+}
+
+size_t align_up_page(size_t n) {
+  constexpr size_t kPage = 2ull << 20; // 2 MiB
+  return (n + kPage - 1) & ~(kPage - 1);
+}
+
+// Grow to at least `need` bytes. Frees the previous base with hipFreeAsync on
+// `stream` so free retires after any prior kernels that still read it.
+void moe_ws_ensure_locked(
+    MoeWs& w,
+    size_t need,
+    int device,
+    hipStream_t stream) {
+  need = align_up_page(need);
+  if (need == 0)
+    return;
+  if (w.base != nullptr && need <= w.capacity && w.device == device)
+    return;
+
+  void* p = nullptr;
+  hipError_t err = hipSuccess;
+  if (stream) {
+    err = hipMallocAsync(&p, need, stream);
+  } else {
+    err = hipMalloc(&p, need);
+  }
+  if (err != hipSuccess || !p) {
+    (void)hipGetLastError();
+    // Fallback: blocking alloc (e.g. pool exhausted).
+    p = nullptr;
+    err = hipMalloc(&p, need);
+  }
+  if (err != hipSuccess || !p) {
+    (void)hipGetLastError();
+    throw std::runtime_error(
+        "moe_ws: hipMalloc failed (" + std::to_string(need) + " bytes)");
+  }
+
+  if (w.base) {
+    // Stream-ordered free: safe once prior MoE kernels on this stream finish.
+    // Do NOT keep retired slabs — that was the GTT/VRAM leak.
+    if (stream) {
+      (void)hipFreeAsync(w.base, stream);
+    } else {
+      (void)hipFree(w.base);
+    }
+  }
+  w.base = p;
+  w.capacity = need;
+  w.device = device;
+  w.offset = 0;
+}
+
+} // namespace
+
+void moe_ws_begin(CommandEncoder& encoder, size_t bytes_needed) {
+  auto& w = moe_ws();
+  std::lock_guard<std::mutex> g(w.mu);
+  w.offset = 0;
+  if (bytes_needed == 0)
+    return;
+  // Exact need + small headroom for alignment of individual bumps (not 50%).
+  size_t need = bytes_needed + (1 << 20);
+  hipStream_t st = static_cast<hipStream_t>(encoder.stream());
+  moe_ws_ensure_locked(w, need, encoder.device().hip_device(), st);
+}
+
+void moe_ws_alloc(CommandEncoder& encoder, array& a) {
+  size_t nbytes = a.nbytes();
+  size_t aligned = align_up_256(nbytes == 0 ? 256 : nbytes);
+
+  auto& w = moe_ws();
+  std::lock_guard<std::mutex> g(w.mu);
+  hipStream_t st = static_cast<hipStream_t>(encoder.stream());
+  int dev = encoder.device().hip_device();
+  if (!w.base || w.offset + aligned > w.capacity) {
+    // Under-estimate from begin(): grow to current offset + remaining request.
+    // Freeing old base is OK only if no live shell from *this* primitive still
+    // points into it — callers must size begin() correctly. Fallback path
+    // stream-syncs first so in-flight shells' kernels complete before free.
+    size_t need = w.offset + aligned + (1 << 20);
+    if (w.base && w.offset > 0) {
+      // Mid-primitive grow is rare (begin under-sized). Sync so prior bumps'
+      // kernels (already enqueued) finish before we free the slab they use.
+      if (st)
+        (void)hipStreamSynchronize(st);
+      else
+        (void)hipDeviceSynchronize();
+      // After sync, free old immediately (sync free) then alloc fresh.
+      (void)hipFree(w.base);
+      w.base = nullptr;
+      w.capacity = 0;
+      w.offset = 0;
+      need = aligned + (1 << 20);
+    }
+    moe_ws_ensure_locked(w, need, dev, st);
+  }
+
+  void* ptr = static_cast<char*>(w.base) + w.offset;
+  w.offset += aligned;
+
+  // Shell only — HBM owned by the single live slab (freed on grow / process end).
+  auto* rb = new RocmBuffer{
+      ptr,
+      nbytes,
+      /*is_managed=*/false,
+      w.device,
+      /*host_shadow=*/nullptr,
+      /*host_dirty=*/false,
+      /*alloc_stream=*/encoder.stream()};
+  // The slab owns the storage. A custom Data deleter releases only this shell
+  // and marks the array borrowed, so is_donatable() rejects its storage.
+  a.set_data(allocator::Data(allocator::Buffer{rb}, [](allocator::Buffer b) {
+    auto* shell = static_cast<RocmBuffer*>(b.ptr());
+    // A CPU read of the workspace may have given the shell a host shadow.
+    mlx::core::rocm::allocator().release_host_shadow(*shell);
+    delete shell;
+  }));
+}
+
+void segmented_mm_device(
+    CommandEncoder& encoder,
+    const array& a,
+    const array& b,
+    const array& segments,
+    array& out,
+    int M,
+    int N,
+    int num_segments,
+    bool a_transposed,
+    int64_t lda,
+    int64_t a_k_stride,
+    bool b_transposed,
+    int64_t ldb,
+    int64_t b_k_stride,
+    int64_t out_stride) {
+  encoder.set_input_array(a);
+  encoder.set_input_array(b);
+  encoder.set_input_array(segments);
+  encoder.set_output_array(out);
+
+  const void* a_ptr = gpu_ptr<void>(a);
+  const void* b_ptr = gpu_ptr<void>(b);
+  void* out_ptr = gpu_ptr<void>(out);
+  const uint32_t* seg_ptr = gpu_ptr<const uint32_t>(segments);
+
+  dim3 block(TILE_N, TILE_M);
+  dim3 grid(
+      (N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M, num_segments);
+
+  encoder.launch_kernel([=](hipStream_t stream) {
+    auto launch = [&](auto* typed_a, auto* typed_b, auto* typed_c) {
+      // typed_a is const T* — strip pointer AND const so Acc is not const float.
+      using T = std::remove_const_t<std::remove_pointer_t<decltype(typed_a)>>;
+      if (a_transposed && b_transposed) {
+        hipLaunchKernelGGL(
+            (segmented_mm_device_kernel<T, true, true>),
+            grid,
+            block,
+            0,
+            stream,
+            typed_a,
+            typed_b,
+            typed_c,
+            seg_ptr,
+            M,
+            N,
+            a_k_stride,
+            b_k_stride,
+            out_stride,
+            static_cast<int>(lda),
+            static_cast<int>(ldb));
+      } else if (a_transposed && !b_transposed) {
+        hipLaunchKernelGGL(
+            (segmented_mm_device_kernel<T, true, false>),
+            grid,
+            block,
+            0,
+            stream,
+            typed_a,
+            typed_b,
+            typed_c,
+            seg_ptr,
+            M,
+            N,
+            a_k_stride,
+            b_k_stride,
+            out_stride,
+            static_cast<int>(lda),
+            static_cast<int>(ldb));
+      } else if (!a_transposed && b_transposed) {
+        hipLaunchKernelGGL(
+            (segmented_mm_device_kernel<T, false, true>),
+            grid,
+            block,
+            0,
+            stream,
+            typed_a,
+            typed_b,
+            typed_c,
+            seg_ptr,
+            M,
+            N,
+            a_k_stride,
+            b_k_stride,
+            out_stride,
+            static_cast<int>(lda),
+            static_cast<int>(ldb));
+      } else {
+        hipLaunchKernelGGL(
+            (segmented_mm_device_kernel<T, false, false>),
+            grid,
+            block,
+            0,
+            stream,
+            typed_a,
+            typed_b,
+            typed_c,
+            seg_ptr,
+            M,
+            N,
+            a_k_stride,
+            b_k_stride,
+            out_stride,
+            static_cast<int>(lda),
+            static_cast<int>(ldb));
+      }
+    };
+    switch (a.dtype()) {
+      case float32:
+        launch(
+            static_cast<const float*>(a_ptr),
+            static_cast<const float*>(b_ptr),
+            static_cast<float*>(out_ptr));
+        break;
+      case bfloat16:
+        launch(
+            static_cast<const hip_bfloat16*>(a_ptr),
+            static_cast<const hip_bfloat16*>(b_ptr),
+            static_cast<hip_bfloat16*>(out_ptr));
+        break;
+      case float16:
+        launch(
+            static_cast<const __half*>(a_ptr),
+            static_cast<const __half*>(b_ptr),
+            static_cast<__half*>(out_ptr));
+        break;
+      default:
+        throw std::runtime_error("Unsupported dtype for segmented_mm_device");
+    }
+  });
+}
+
+} // namespace mlx::core::rocm
