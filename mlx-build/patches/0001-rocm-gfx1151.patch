+  COMMAND ${CMAKE_CXX_COMPILER} -print-file-name=include/c++
+  OUTPUT_VARIABLE GCC_CXX_INCLUDE_BASE
+  OUTPUT_STRIP_TRAILING_WHITESPACE)
