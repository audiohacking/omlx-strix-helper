+  list(APPEND HIP_INCLUDE_FLAGS "-I/usr/include/c++/${GCC_MAJOR_VERSION}")
+  list(APPEND HIP_INCLUDE_FLAGS
+       "-I/usr/include/x86_64-linux-gnu/c++/${GCC_MAJOR_VERSION}")
+  list(APPEND HIP_INCLUDE_FLAGS
+       "-I/usr/include/c++/${GCC_MAJOR_VERSION}/backward")
+endif()
