+#define UNARY_FLOAT_OP(name, op) \
+struct name { \
+  template <typename T> \
+  __device__ T operator()(T x) { \
+    MLX_ROCM_REAL_ONLY(T); \
+    return T(op(static_cast<float>(x))); \
