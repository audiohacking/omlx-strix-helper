+rocblas_datatype to_rocblas_dtype(Dtype dtype) {
+  switch (dtype) {
+    case float32:
+      return rocblas_datatype_f32_r;
+    case float16:
+      return rocblas_datatype_f16_r;
+    case bfloat16:
+      return rocblas_datatype_bf16_r;
+    default:
+      throw std::runtime_error("Unsupported dtype for rocBLAS GEMM");
+  }
+}
