+  list(APPEND HIP_INCLUDE_FLAGS
+       "-I${GCC_CXX_INCLUDE_BASE}/c++/${GCC_MAJOR_VERSION}/x86_64-linux-gnu")
+  list(APPEND HIP_INCLUDE_FLAGS
+       "-I${GCC_CXX_INCLUDE_BASE}/c++/${GCC_MAJOR_VERSION}/backward")
+endif()
