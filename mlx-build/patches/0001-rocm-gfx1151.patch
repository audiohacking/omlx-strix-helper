+      break;
+    }
+    case uint64: {
+      uint64_t start = static_cast<uint64_t>(start_);
+      uint64_t step = static_cast<uint64_t>(step_);
+      encoder.add_kernel_node(
+          &rocm::arange_kernel<uint64_t>,
