+///////////////////////////////////////////////////////////////////////////////
+// HipEvent implementations
+///////////////////////////////////////////////////////////////////////////////
+
+namespace {
+
+// Manage cached hipEvent_t objects. Keyed by (device, flags): a hipEvent is
+// bound to the device current when it was created, and recording it on another
+// device's stream is invalid (hangs the queue on a multi-GPU host). So pool and
+// hand back events per device, creating new ones on the CURRENT device.
+// [mlxcel #2183] The cache is shared by every thread that evaluates GPU work
+// (server workers on their own streams, CPU-stream waits, completion
+// handlers), so it is locked. Unlocked, concurrent create/release corrupted
+// the vectors and handed one hipEvent_t to two events, or a destroyed one to a
+// record: 8 threads evaluating on their own streams failed within a few rounds
+// with "hipEventRecord(event_, stream) failed: invalid resource handle".
+// Upstream CUDA's CudaEventPool (mlx/backend/cuda/event.cu at the pin) instead
+// caches only on the thread that first used it; a lock keeps the cache for the
+// server's worker threads, where decode runs, and is uncontended otherwise.
+// hipEventCreateWithFlags runs outside the lock.
+// [mlxcel #2197] The map and its mutex are leaked, like the JIT module cache
+// and the device table (LOCAL_FIXES items 35 and 39): a HipEvent released
+// during static teardown would otherwise push into a destroyed map, and the
+// map's destructor ran hipEventDestroy on every pooled handle at exit, which
+// fails on a faulted device (item 7). The handles go away with the process.
+struct HipEventPool {
+  static HipEventHandle create(int flags) {
+    int dev = 0;
+    (void)hipGetDevice(&dev);
+    {
+      std::lock_guard<std::mutex> lock(mutex());
+      auto& cache = cache_for(dev, flags);
+      if (!cache.empty()) {
+        HipEventHandle ret = std::move(cache.back());
+        cache.pop_back();
+        return ret;
+      }
+    }
+    return HipEventHandle(flags); // created on the current device
+  }
+
+  static void release(HipEventHandle event) {
+    std::lock_guard<std::mutex> lock(mutex());
+    cache_for(event.device, event.flags).push_back(std::move(event));
+  }
+
+ private:
+  // Callers hold mutex().
+  static std::vector<HipEventHandle>& cache_for(int device, int flags) {
+    static auto* cache =
+        new std::map<std::pair<int, int>, std::vector<HipEventHandle>>;
+    return (*cache)[{device, flags}];
+  }
+
+  static std::mutex& mutex() {
+    static auto* mu = new std::mutex;
+    return *mu;
+  }
+};
+
+using Clock = std::chrono::steady_clock;
+
+// Deadline for a host wait under MLX_ROCM_GPU_WATCHDOG_SECS, or the far future
+// when the watchdog is off (the default).
+Clock::time_point watchdog_deadline() {
+  int secs = gpu_watchdog_seconds();
+  if (secs <= 0) {
+    return Clock::time_point::max();
+  }
+  return Clock::now() + std::chrono::seconds(secs);
+}
+
+} // namespace
+
+HipEventHandle::HipEventHandle(int flags) : flags(flags) {
+  CHECK_HIP_ERROR(hipEventCreateWithFlags(&handle_, flags));
+  assert(handle_ != nullptr);
+  (void)hipGetDevice(&device); // event is bound to the current device
+}
+
+HipEvent::HipEvent(int flags) : event_(HipEventPool::create(flags)) {}
+
+HipEvent::~HipEvent() {
+  HipEventPool::release(std::move(event_));
+}
+
+hipError_t HipEvent::wait() {
+  // MLX_EVENT_BLOCKING: block (hipEventSynchronize) instead of CPU spin-polling.
+  // The device is created with hipDeviceScheduleBlockingSync, so this sleeps the
+  // thread rather than busy-waiting. On a bandwidth-bound APU decode the spin
+  // poll steals shared-memory-controller bandwidth from the GPU, so blocking can
+  // be a net win despite the wakeup latency. Default keeps the legacy spin.
+  // A faulted stream fails the blocking wait promptly, so the watchdog only
+  // applies to the polling mode.
+  static const bool blocking = std::getenv("MLX_EVENT_BLOCKING") != nullptr;
+  if (blocking) {
+    return hipEventSynchronize(event_);
+  }
+  // Spin-wait with hipEventQuery instead of hipEventSynchronize.
+  // Use progressive backoff to reduce hipEventQuery call overhead.
+  // Anything other than hipErrorNotReady ends the wait: once the queue has
+  // faulted the query returns the fault for the rest of the process, and the
+  // old "until hipSuccess" loop spun forever on it (lablup/mlxcel#1804).
+  const auto deadline = watchdog_deadline();
+  for (uint32_t spins = 0;; spins++) {
+    hipError_t status = hipEventQuery(event_);
+    if (status != hipErrorNotReady) {
+      return status;
+    }
+    if (spins < 100) {
+      // Tight spin for fast completions
+    } else if (spins < 1000) {
+      _mm_pause(); // x86 pause hint (reduces power, avoids pipeline stall)
+    } else {
+      std::this_thread::yield();
+      if ((spins & 1023) == 0 && Clock::now() > deadline) {
+        return kWatchdogExpired;
+      }
+    }
+  }
+}
+
+void HipEvent::wait(hipStream_t stream) {
+  CHECK_HIP_ERROR(hipStreamWaitEvent(stream, event_, 0));
+}
+
+void HipEvent::record(hipStream_t stream) {
+  CHECK_HIP_ERROR(hipEventRecord(event_, stream));
+}
+
+hipError_t HipEvent::query() const {
+  return hipEventQuery(event_);
+}
+
+// Wraps HipEvent with a few features:
+// 1. The class can be copied.
+// 2. Add checks for waiting on un-recorded event.
+class CopyableHipEvent {
+ public:
+  CopyableHipEvent()
+      : event_(std::make_shared<HipEvent>(
+            hipEventDisableTiming)) {}
+            // Note: hipEventBlockingSync removed — on iGPU the blocking wait
+            // contends with GPU for CPU resources. Polling is cheaper.
+
+  [[nodiscard]] hipError_t wait() {
+    check_recorded();
+    return event_->wait();
+  }
+
+  void wait(hipStream_t stream) {
+    check_recorded();
+    event_->wait(stream);
+  }
+
+  void record(hipStream_t stream) {
+    event_->record(stream);
+    recorded_ = true;
+  }
+
+  // hipErrorNotReady until record() has been called, then the HIP status.
+  [[nodiscard]] hipError_t query() const {
+    return recorded_ ? event_->query() : hipErrorNotReady;
+  }
+
+ private:
+  void check_recorded() const {
+    if (!recorded_) {
+      throw std::runtime_error(
+          "Should not wait on a HipEvent before recording.");
+    }
+  }
+
+  std::shared_ptr<HipEvent> event_;
+  bool recorded_{false};
+};
+
+///////////////////////////////////////////////////////////////////////////////
+// AtomicEvent implementations
+///////////////////////////////////////////////////////////////////////////////
+
+namespace {
+
+// Payload of the host callback that lands a signal. It owns a reference to the
+// event state so the counter outlives every copy of the event that could be
+// destroyed while the callback is still queued.
+struct SignalPayload {
+  std::shared_ptr<AtomicEvent::State> state;
+  uint64_t value;
+};
+
+void signal_atomic_callback(void* data) {
+  auto* payload = static_cast<SignalPayload*>(data);
+  payload->state->counter->store(payload->value, std::memory_order_release);
+  delete payload;
+}
+
+// Pool of 8-byte SIGNAL-MEMORY counters for AtomicEvent. The counter is used two
+// ways: the GPU waits on it via hipStreamWaitValue64 (cross-stream Fence) and
+// signals it via hipStreamWriteValue64, AND the CPU polls it (host wait()). HIP
+// REQUIRES the pointer passed to hipStreamWaitValue64/WriteValue64 to be
+// allocated with the hipMallocSignalMemory flag — plain hipHostMalloc memory is
+// accepted by the call (returns success) but the GPU-side wait never observes the
+// value, so on a discrete GPU the stream spins forever (busy 100%, mem-ctrl 0%).
+// Signal memory is host-accessible, so the CPU poll works too. Recycle the blocks
+// (hipFree blocks on a discrete GPU); intentionally leaked at process exit.
+struct PinnedCounterPool {
+  std::mutex m;
+  std::vector<void*> free_list;
+
+  void* acquire() {
+    {
+      std::lock_guard<std::mutex> lk(m);
+      if (!free_list.empty()) {
+        void* p = free_list.back();
+        free_list.pop_back();
+        return p;
+      }
+    }
+    void* p = nullptr;
+    CHECK_HIP_ERROR(hipHostMalloc(
+        &p, sizeof(std::atomic<uint64_t>),
+        hipHostMallocMapped | hipHostMallocCoherent));
+    return p;
+  }
+
+  void release(void* p) {
+    std::lock_guard<std::mutex> lk(m);
+    free_list.push_back(p);
+  }
+};
+
+PinnedCounterPool& counter_pool() {
+  static PinnedCounterPool* pool = new PinnedCounterPool;
+  return *pool;
+}
+
+} // namespace
+
+AtomicEvent::State::State() {
+  // Completion counter in pinned, device-mapped host memory: the GPU signals it
+  // (hipStreamWriteValue64) and the CPU polls it (wait()). On a discrete GPU over
+  // a non-coherent link (TB5 eGPU) device memory is NOT CPU-visible, so the
+  // counter must live in host memory or the host poll spins forever. Drawn from a
+  // recycling pool — see PinnedCounterPool (hipHostFree blocks on a discrete GPU).
+  void* p = counter_pool().acquire();
+  counter = static_cast<std::atomic<uint64_t>*>(p);
+  counter->store(0, std::memory_order_release);
+}
+
+AtomicEvent::State::~State() {
+  counter_pool().release(counter);
+}
+
+AtomicEvent::AtomicEvent() : state_(std::make_shared<State>()) {}
+
+hipError_t AtomicEvent::status() const {
+  auto recorded = static_cast<hipError_t>(
+      state_->error.load(std::memory_order_acquire));
+  if (recorded != hipSuccess) {
+    return recorded;
+  }
+  hipStream_t stream = state_->stream.load(std::memory_order_acquire);
+  if (stream == nullptr) {
+    return hipSuccess; // nothing queued on a GPU stream yet
+  }
+  // hipSuccess (idle) and hipErrorNotReady (busy) both mean the callback can
+  // still fire: it runs on the runtime's callback thread, slightly after the
+  // stream itself reports idle.
+  hipError_t queried = hipStreamQuery(stream);
+  return queried == hipErrorNotReady ? hipSuccess : queried;
+}
+
+hipError_t AtomicEvent::wait(uint64_t value) {
+  using namespace std::chrono_literals;
+  auto* ac = atomic();
+  static const bool blocking = std::getenv("MLX_EVENT_BLOCKING") != nullptr;
+  const auto deadline = watchdog_deadline();
+  // The counter is landed by a hipLaunchHostFunc callback, and a stream that
+  // has faulted never runs its callbacks, so poll the signaling stream about
+  // once a millisecond and give up once it reports a failure. The status query
+  // is skipped entirely for an event nothing has signaled from a GPU stream.
+  auto next_poll = Clock::now() + 1ms;
+  for (uint32_t spins = 0; ac->load(std::memory_order_acquire) < value;
+       spins++) {
+    if (blocking) {
+      // Sleep briefly instead of hot-yielding so the host poll of this pinned
+      // counter doesn't contend with the GPU on the APU memory controller.
+      std::this_thread::sleep_for(std::chrono::microseconds(50));
+    } else {
+      std::this_thread::yield();
+    }
+    if ((spins & 63) != 0) {
+      continue;
+    }
+    auto now = Clock::now();
+    if (now < next_poll) {
+      continue;
+    }
+    next_poll = now + 1ms;
+    hipError_t st = status();
+    if (st != hipSuccess) {
+      // The callback may have landed the value between the loop test and the
+      // status query; a landed value is a completed wait, whatever the stream
+      // says afterwards.
+      return ac->load(std::memory_order_acquire) >= value ? hipSuccess : st;
+    }
+    if (now > deadline) {
+      return kWatchdogExpired;
+    }
+  }
+  return hipSuccess;
+}
+
+hipError_t AtomicEvent::wait(hipStream_t stream, uint64_t value) {
+  // Do NOT use hipStreamWaitValue64 on the host counter: it requires
+  // hipMallocSignalMemory and silently never observes a plain pinned-host value,
+  // wedging the queue. The counter is signaled by a host callback when the
+  // producer stream reaches the signal point, so block the host here until the
+  // value lands; subsequent work on this stream is correctly ordered after it.
+  (void)stream;
+  return wait(value);
+}
+
+hipError_t AtomicEvent::wait(Stream s, uint64_t value) {
+  if (s.device == mlx::core::Device::cpu) {
+    // The CPU stream's task blocks on the counter; a failed signaling stream
+    // throws inside the task, which the scheduler records as the CPU stream's
+    // error (the Event layer goes through scheduler::wait_event instead).
+    scheduler::enqueue(s, [*this, value]() mutable {
+      if (hipError_t st = wait(value); st != hipSuccess) {
+        throw std::runtime_error(describe_device_error(
+            st, "waiting on a CPU stream for a stream's completion signal"));
+      }
+    });
+    return hipSuccess;
+  }
+  auto& encoder = get_command_encoder(s);
+  encoder.commit();
+  return wait(encoder.stream(), value);
+}
+
+void AtomicEvent::signal(uint64_t value) {
+  atomic()->store(value, std::memory_order_release);
+}
+
+void AtomicEvent::signal(hipStream_t stream, uint64_t value) {
+  // Signal the host-resident counter from the stream via a host callback that
+  // fires when the stream reaches this point. We do NOT use hipStreamWriteValue64
+  // here: it REQUIRES a hipMallocSignalMemory pointer, but returns success on a
+  // plain pinned-host counter while never actually landing the write — so the
+  // host poll (wait()) spins forever and the discrete-GPU queue wedges (busy
+  // 100%, mem-ctrl 0%). The host callback always delivers the value correctly.
+  state_->stream.store(stream, std::memory_order_release);
+  auto* payload = new SignalPayload{state_, value};
+  hipError_t st = hipLaunchHostFunc(stream, signal_atomic_callback, payload);
+  if (st != hipSuccess) {
+    delete payload;
+    // The callback will never run, so no waiter would ever wake. Mark the
+    // event failed first (waiters on other threads read it), then report.
+    state_->error.store(static_cast<int>(st), std::memory_order_release);
+    check_hip_error("hipLaunchHostFunc", st);
+  }
+}
+
+void AtomicEvent::signal(Stream s, uint64_t value) {
+  if (s.device == mlx::core::Device::cpu) {
+    // Fence::update signals from CPU streams too; land the value from the
+    // stream's own task so it is ordered after the work it fences.
+    scheduler::enqueue(s, [*this, value]() mutable { signal(value); });
+    return;
+  }
+  auto& encoder = get_command_encoder(s);
+  encoder.commit();
+  signal(encoder.stream(), value);
+}
+
+bool AtomicEvent::is_signaled(uint64_t value) const {
+  return atomic()->load(std::memory_order_acquire) >= value;
+}
+
+uint64_t AtomicEvent::value() const {
+  return atomic()->load(std::memory_order_acquire);
+}
+
+} // namespace rocm
+
+///////////////////////////////////////////////////////////////////////////////
+// Event implementations
+///////////////////////////////////////////////////////////////////////////////
+
+namespace {
+
+struct EventImpl {
+  std::unique_ptr<rocm::CopyableHipEvent> hip;
+  std::unique_ptr<rocm::AtomicEvent> atomic;
+  // Set when the event is "signaled" purely on the host because it was created
+  // during HIP graph capture: recording a real completion event onto the
+  // captured stream would bake it into the graph (never fires under capture),
+  // so we skip the device record and treat the event as already satisfied. The
+  // recorded compute kernels still execute on replay; completion is handled by
+  // an explicit stream sync after hipGraphLaunch.
+  bool host_signaled{false};
+  // Error attached to the event (ml-explore/mlx#3742). The CPU scheduler
+  // stores its stream's error here through Event::set_error, and this backend
+  // stores the signaling GPU stream's encoder-owned Error when a wait or a
+  // query finds that stream failed (lablup/mlxcel#1804). Event::wait() and
+  // array::detach_event() throw it through Event::check_error().
+  std::atomic<Error*> error{nullptr};
+
+  bool is_created() const {
+    return hip || atomic;
+  }
+
+  void ensure_created(Stream s, uint64_t signal_value) {
+    if (is_created()) {
+      return;
+    }
+    if (s.device == mlx::core::Device::cpu || signal_value > 1) {
+      atomic = std::make_unique<rocm::AtomicEvent>();
+    } else {
+      // Bind the stream's device current before creating the hipEvent — it is
+      // bound to whatever device is current at creation, and recording it on a
+      // different device's stream hangs the queue on a multi-GPU host.
+      (void)rocm::get_command_encoder(s);
+      hip = std::make_unique<rocm::CopyableHipEvent>();
+    }
+  }
+};
+
+EventImpl& impl_of(const Event& event) {
+  return event.cast<EventImpl>();
+}
+
+// Attach the failure of the stream that signals |event| to the event, keeping
+// the earliest message. Never throws and never binds a device, so it is safe
+// from const queries and on a device whose every HIP call now fails.
+void poison_event(const Event& event, hipError_t status, const char* where) {
+  Error& error = rocm::record_stream_error(event.stream(), status, where);
+  const_cast<Event&>(event).set_error(error);
+}
+
+// poison_event(), then throw the error the way every other backend does:
+// through Event::check_error(), which clears it. Falls back to a plain throw
+// if a concurrent check consumed the message first.
+[[noreturn]] void
+fail_event(Event& event, hipError_t status, const char* where) {
+  poison_event(event, status, where);
+  event.check_error();
+  throw std::runtime_error(rocm::describe_device_error(status, where));
+}
+
+constexpr const char* kWaitHost = "waiting on the host for a stream event";
+constexpr const char* kWaitSignal =
+    "waiting on the host for a stream's completion signal";
+
+} // namespace
+
+Event::Event(Stream s) : stream_(s) {
+  event_ = std::shared_ptr<void>(
+      new EventImpl(), [](void* ptr) { delete static_cast<EventImpl*>(ptr); });
+}
+
+void Event::wait() {
+  check_error();
+  auto& event = impl_of(*this);
+  // Capture-created event: nothing to wait for on the host (see EventImpl).
+  if (event.host_signaled) {
+    return;
+  }
+  assert(event.is_created());
+  if (event.hip) {
+    assert(value() == 1);
+    if (hipError_t st = event.hip->wait(); st != hipSuccess) {
+      fail_event(*this, st, kWaitHost);
+    }
+  } else {
+    if (hipError_t st = event.atomic->wait(value()); st != hipSuccess) {
+      fail_event(*this, st, kWaitSignal);
+    }
+  }
+  check_error();
+}
+
+void Event::wait(Stream s) {
+  auto& event = impl_of(*this);
+  if (event.host_signaled) {
+    return;
+  }
+  assert(event.is_created());
+  if (s.device == mlx::core::Device::cpu) {
+    // Through the scheduler's wait_event so the CPU stream inherits the
+    // event's error, as the Metal and CUDA backends do.
+    scheduler::wait_event(s, *this, [value = value()](Event& self) {
+      auto& ev = impl_of(self);
+      hipError_t st = ev.hip ? ev.hip->wait() : ev.atomic->wait(value);
+      if (st != hipSuccess) {
+        fail_event(self, st, ev.hip ? kWaitHost : kWaitSignal);
+      }
+    });
+    return;
+  }
+  auto& encoder = rocm::get_command_encoder(s);
+  encoder.commit();
+  if (event.hip) {
+    assert(value() == 1);
+    event.hip->wait(encoder.stream());
+  } else if (hipError_t st = event.atomic->wait(encoder.stream(), value());
+             st != hipSuccess) {
+    fail_event(*this, st, kWaitSignal);
+  }
+}
+
+void Event::signal(Stream s) {
+  auto& event = impl_of(*this);
+  event.ensure_created(s, value());
+  if (event.hip) {
+    assert(value() == 1);
+    if (s.device == mlx::core::Device::cpu) {
+      throw std::runtime_error("HipEvent can not be recorded on a CPU stream.");
+    }
+    auto& encoder = rocm::get_command_encoder(s);
+    encoder.commit();
+    event.hip->record(encoder.stream());
+  } else if (s.device == mlx::core::Device::cpu) {
+    // Through the scheduler's signal_event so a CPU stream that already
+    // failed poisons the event before signaling it.
+    scheduler::signal_event(s, *this, [value = value()](Event& self) {
+      impl_of(self).atomic->signal(value);
+    });
+  } else {
+    event.atomic->signal(s, value());
+  }
+}
+
+std::atomic<Error*>& Event::error() {
+  return impl_of(*this).error;
+}
+
+bool Event::is_signaled() const {
+  auto& event = impl_of(*this);
+  if (event.host_signaled) {
+    return true;
+  }
+  if (!event.is_created()) {
+    return false;
+  }
+  // A failed stream never signals. Report the event as signaled with its
+  // error attached, so array::is_available() detaches it and throws instead
+  // of leaving the array pending forever, and so a status read that never
+  // waits (the bridge's stashed_launch_state) can see the failure.
+  hipError_t status;
+  const char* where;
+  if (event.hip) {
+    assert(value() == 1);
+    status = event.hip->query();
+    if (status == hipSuccess) {
+      return true;
+    }
+    if (status == hipErrorNotReady) {
+      return false;
+    }
+    where = "querying a stream event";
+  } else {
+    if (event.atomic->is_signaled(value())) {
+      return true;
+    }
+    status = event.atomic->status();
+    if (status == hipSuccess) {
+      return false;
+    }
+    if (event.atomic->is_signaled(value())) {
+      return true;
+    }
+    where = "querying a stream's completion signal";
+  }
+  poison_event(*this, status, where);
+  return true;
+}
+
+} // namespace mlx::core
diff --git a/mlx/backend/rocm/fence.cpp b/mlx/backend/rocm/fence.cpp
new file mode 100644
index 0000000..fb8b444
--- /dev/null
+++ b/mlx/backend/rocm/fence.cpp
@@ -0,0 +1,41 @@
+// Copyright © 2025 Apple Inc.
+
+#include "mlx/fence.h"
+#include "mlx/backend/rocm/device.h"
+#include "mlx/backend/rocm/event.h"
+
+#include <stdexcept>
+
+namespace mlx::core {
+
+struct FenceImpl {
+  uint32_t count;
+  rocm::AtomicEvent event;
+};
+
+Fence::Fence(Stream s) {
+  fence_ = std::shared_ptr<void>(
+      new FenceImpl{0}, [](void* ptr) { delete static_cast<FenceImpl*>(ptr); });
+}
+
+void Fence::wait(Stream s, const array&, uint32_t value) {
+  auto* fence = static_cast<FenceImpl*>(fence_.get());
+  // The fence is signaled by a host callback on the updating stream; if that
+  // stream has failed the callback never runs, and the wait reports the
+  // failure instead of blocking forever (lablup/mlxcel#1804). The throw
+  // leaves eval_impl through its catch block like any primitive error.
+  hipError_t st = fence->event.wait(value);
+  if (st != hipSuccess) {
+    throw std::runtime_error(
+        rocm::describe_device_error(st, "waiting for a stream fence"));
+  }
+}
+
+uint32_t Fence::update(Stream s, const array&, bool cross_device) {
+  auto* fence = static_cast<FenceImpl*>(fence_.get());
+  fence->count++;
+  fence->event.signal(s, fence->count);
+  return fence->count;
+}
+
+} // namespace mlx::core
diff --git a/mlx/backend/rocm/fft.hip b/mlx/backend/rocm/fft.hip
new file mode 100644
index 0000000..1506f7b
--- /dev/null
+++ b/mlx/backend/rocm/fft.hip
@@ -0,0 +1,486 @@
+// Copyright © 2025 Apple Inc.
+
+// mlxcelverse: ROCm FFT through hipFFT (lablup/mlxcel#1825).
+//
+// Ported from mlx/backend/cuda/fft.cu. Two differences are worth knowing before
+// reading it against the CUDA original.
+//
+// This hipFFT has no `hipfftXtMakePlanMany` or `hipfftXtExec`, the generic
+// entry points the CUDA file uses to pass input, output and execution types
+// separately. It has the typed API instead: `hipfftMakePlanMany64` takes one
+// `hipfftType` (C2C, R2C or C2R) and each transform has its own exec function.
+// MLX only ever asks for float32 and complex64 here, so the typed API covers
+// the same ground and the type-selection helpers the CUDA file needs disappear.
+//
+// hipFFT work is not a HIP graph kernel node, so it goes through
+// `CommandEncoder::launch_kernel`, which splits the accumulated graph, runs the
+// call on the same stream ordered after it, and starts the next graph fresh.
+// That is the same path the rocBLAS and hipBLASLt GEMMs take in matmul.cpp.
+
+#include "mlx/backend/rocm/device.h"
+#include "mlx/backend/rocm/allocator.h"
+#include "mlx/backend/rocm/kernel_utils.hpp"
+#include "mlx/backend/rocm/lru_cache.h"
+#include "mlx/backend/rocm/utils.h"
+#include "mlx/backend/common/utils.h"
+#include "mlx/backend/gpu/copy.h"
+#include "mlx/primitives.h"
+
+#include <hip/hip_runtime.h>
+#include <hipfft/hipfft.h>
+
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace mlx::core {
+
+namespace rocm {
+
+// Scales an FFT result in place. hipFFT, like cuFFT, leaves the 1/n of an
+// inverse transform to the caller.
+template <typename T>
+__global__ void scale_fft_output(T* out, T scale, size_t size) {
+  size_t index = static_cast<size_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+  size_t stride = static_cast<size_t>(gridDim.x) * blockDim.x;
+  for (size_t i = index; i < size; i += stride) {
+    out[i] = out[i] * scale;
+  }
+}
+
+} // namespace rocm
+
+namespace {
+
+void check_hipfft_error(const char* name, hipfftResult err) {
+  if (err != HIPFFT_SUCCESS) {
+    throw std::runtime_error(
+        std::string(name) +
+        " failed with code: " + std::to_string(static_cast<int>(err)) + ".");
+  }
+}
+
+#define CHECK_HIPFFT_ERROR(cmd) check_hipfft_error(#cmd, (cmd))
+
+enum class FFTTransformType : uint8_t {
+  C2C = 0,
+  R2C = 1,
+  C2R = 2,
+};
+
+hipfftType hipfft_type(FFTTransformType transform_type) {
+  switch (transform_type) {
+    case FFTTransformType::C2C:
+      return HIPFFT_C2C;
+    case FFTTransformType::R2C:
+      return HIPFFT_R2C;
+    case FFTTransformType::C2R:
+      return HIPFFT_C2R;
+  }
+  throw std::runtime_error("[FFT] Unsupported hipFFT transform type.");
+}
+
+// The backend's LRU cache is an unordered_map keyed by the type itself, so it
+// needs std::hash. A string key avoids specializing std::hash for a type in an
+// anonymous namespace; plan lookups happen once per shape, so its cost does not
+// matter.
+std::string make_plan_key(
+    int device_id,
+    FFTTransformType transform_type,
+    int64_t n,
+    int64_t batch) {
+  return std::to_string(device_id) + ":" +
+      std::to_string(static_cast<int>(transform_type)) + ":" +
+      std::to_string(n) + ":" + std::to_string(batch);
+}
+
+struct HipFFTPlan {
+  HipFFTPlan(int device_id, hipfftHandle handle, size_t workspace_size)
+      : device_id(device_id), handle(handle), workspace_size(workspace_size) {}
+
+  ~HipFFTPlan() {
+    if (handle != 0) {
+      try {
+        hipfftDestroy(handle);
+      } catch (...) {
+      }
+    }
+  }
+
+  HipFFTPlan(const HipFFTPlan&) = delete;
+  HipFFTPlan& operator=(const HipFFTPlan&) = delete;
+
+  int device_id;
+  hipfftHandle handle;
+  size_t workspace_size;
+};
+
+struct OrderedArray {
+  array arr;
+  std::vector<int> order;
+};
+
+// Same capacity as the CUDA file. This was once 8: past that, the first plan
+// eviction hung inside hipfftDestroy (rocFFT's hipFree never returned). The
+// cause was not rocFFT or the number of live plans but a late
+// hipSetDeviceFlags(hipDeviceScheduleBlockingSync): the allocator had already
+// created the null stream's queue with completion signals that cannot carry
+// the handler hipFree's device-wide sync attaches, so that wait never woke.
+// rocm::ensure_device_flags() now runs before the first queue exists
+// (lablup/mlxcel#1876, LOCAL_FIXES.md entries 18 and 20).
+// MLX_ROCM_FFT_CACHE_SIZE overrides the capacity: a positive integer up to
+// INT_MAX; any other value warns once and keeps the default
+// (capacity_from_env in lru_cache.h, lablup/mlxcel#2051).
+auto& fft_plan_cache() {
+  static rocm::LRUBytesKeyCache<std::string, std::shared_ptr<HipFFTPlan>> cache(
+      "MLX_ROCM_FFT_CACHE_SIZE",
+      /* default_capacity */ 128);
+  return cache;
+}
+
+std::mutex& fft_plan_cache_mutex() {
+  static std::mutex m;
+  return m;
+}
+
+int64_t input_embed(FFTTransformType transform_type, int64_t n) {
+  return transform_type == FFTTransformType::C2R ? (n / 2 + 1) : n;
+}
+
+int64_t output_embed(FFTTransformType transform_type, int64_t n) {
+  return transform_type == FFTTransformType::R2C ? (n / 2 + 1) : n;
+}
+
+std::shared_ptr<HipFFTPlan> get_fft_plan(
+    rocm::CommandEncoder& encoder,
+    FFTTransformType transform_type,
+    int64_t n,
+    int64_t batch) {
+  auto key =
+      make_plan_key(encoder.device().hip_device(), transform_type, n, batch);
+
+  auto& cache = fft_plan_cache();
+  // The cache is shared, and building a plan is not idempotent in cost, so the
+  // check-build-insert runs under one lock.
+  std::lock_guard<std::mutex> cache_lock(fft_plan_cache_mutex());
+  if (auto entry = cache.get(key); entry.has_value()) {
+    return *entry;
+  }
+
+  encoder.device().make_current();
+
+  hipfftHandle handle = 0;
+  size_t workspace_size = 0;
+  try {
+    CHECK_HIPFFT_ERROR(hipfftCreate(&handle));
+    // The work area is allocated per execution from MLX's pool rather than by
+    // hipFFT, so a cached plan holds no device memory of its own.
+    CHECK_HIPFFT_ERROR(hipfftSetAutoAllocation(handle, 0));
+
+    long long plan_n[1] = {n};
+    long long inembed[1] = {input_embed(transform_type, n)};
+    long long onembed[1] = {output_embed(transform_type, n)};
+    CHECK_HIPFFT_ERROR(hipfftMakePlanMany64(
+        handle,
+        /* rank = */ 1,
+        plan_n,
+        inembed,
+        /* istride = */ 1,
+        /* idist = */ input_embed(transform_type, n),
+        onembed,
+        /* ostride = */ 1,
+        /* odist = */ output_embed(transform_type, n),
+        hipfft_type(transform_type),
+        batch,
+        &workspace_size));
+  } catch (...) {
+    if (handle != 0) {
+      hipfftDestroy(handle);
+    }
+    throw;
+  }
+
+  auto plan = std::make_shared<HipFFTPlan>(
+      encoder.device().hip_device(), handle, workspace_size);
+  cache.put(key, plan);
+  return plan;
+}
+
+std::vector<int> make_identity_order(int ndim) {
+  std::vector<int> order(ndim);
+  std::iota(order.begin(), order.end(), 0);
+  return order;
+}
+
+std::vector<int> move_axis_to_back_permutation(int ndim, int axis_pos) {
+  std::vector<int> perm;
+  perm.reserve(ndim);
+  for (int i = 0; i < ndim; ++i) {
+    if (i != axis_pos) {
+      perm.push_back(i);
+    }
+  }
+  perm.push_back(axis_pos);
+  return perm;
+}
+
+std::vector<int> apply_permutation(
+    const std::vector<int>& values,
+    const std::vector<int>& perm) {
+  std::vector<int> out(perm.size());
+  for (size_t i = 0; i < perm.size(); ++i) {
+    out[i] = values[perm[i]];
+  }
+  return out;
+}
+
+int find_axis_position(const std::vector<int>& order, int axis) {
+  auto it = std::find(order.begin(), order.end(), axis);
+  if (it == order.end()) {
+    throw std::runtime_error("[FFT] Internal axis tracking mismatch.");
+  }
+  return static_cast<int>(it - order.begin());
+}
+
+OrderedArray prepare_input(
+    const OrderedArray& current,
+    int axis,
+    bool allow_direct,
+    rocm::CommandEncoder& encoder,
+    Stream s) {
+  int axis_pos = find_axis_position(current.order, axis);
+  bool axis_last = axis_pos == static_cast<int>(current.order.size()) - 1;
+  bool direct = allow_direct && axis_last && current.arr.flags().row_contiguous;
+
+  if (direct) {
+    return current;
+  }
+
+  array view = current.arr;
+  std::vector<int> order = current.order;
+  if (!axis_last) {
+    auto perm = move_axis_to_back_permutation(current.arr.ndim(), axis_pos);
+    view = transpose_in_eval(current.arr, perm);
+    order = apply_permutation(current.order, perm);
+  }
+
+  array packed = contiguous_copy_gpu(view, s);
+  encoder.add_temporary(packed);
+  return {std::move(packed), std::move(order)};
+}
+
+void execute_fft(
+    const array& in,
+    array& out,
+    FFTTransformType transform_type,
+    bool inverse,
+    rocm::CommandEncoder& encoder) {
+  if (!in.flags().row_contiguous || in.strides(-1) != 1) {
+    throw std::runtime_error("[FFT] Expected packed row-contiguous FFT input.");
+  }
+
+  int64_t n =
+      transform_type == FFTTransformType::C2R ? out.shape(-1) : in.shape(-1);
+  int64_t batch = in.shape().empty() ? 1 : in.size() / in.shape(-1);
+  auto plan = get_fft_plan(encoder, transform_type, n, batch);
+
+  encoder.set_input_array(in);
+  out.set_data(mlx::core::rocm::malloc_async(out.nbytes(), encoder));
+  encoder.set_output_array(out);
+
+  // The work area comes from the same async pool as every other buffer on this
+  // encoder. A synchronous allocator::malloc here deadlocks: it waits on the
+  // pool while the encoder still holds outstanding async frees.
+  size_t ws_bytes = std::max<size_t>(plan->workspace_size, 1);
+  array workspace({static_cast<int>(ws_bytes)}, uint8, nullptr, {});
+  workspace.set_data(mlx::core::rocm::malloc_async(ws_bytes, encoder));
+  encoder.add_temporary(workspace);
+
+  void* in_ptr = const_cast<void*>(gpu_ptr<const void>(in));
+  void* out_ptr = gpu_ptr<void>(out);
+  void* ws_ptr = gpu_ptr<void>(workspace);
+  int direction = inverse ? HIPFFT_BACKWARD : HIPFFT_FORWARD;
+  hipfftHandle handle = plan->handle;
+
+  // hipFFT is not a graph kernel node; launch_kernel splits the graph and runs
+  // this on the encoder stream, ordered after what came before. launch_kernel
+  // calls the lambda synchronously and drops it on return, so the captured
+  // plan lives only as long as the enqueue, not the asynchronous execution.
+  // An eviction later is still safe for that execution: hipfftDestroy frees
+  // the plan's device memory through hipFree, which synchronizes the device
+  // first. That argument covers the eager launch, which is the only launch path
+  // now that use_hip_graphs() is permanently off.
+  encoder.launch_kernel([handle,
+                         plan,
+                         in_ptr,
+                         out_ptr,
+                         ws_ptr,
+                         direction,
+                         transform_type](hipStream_t stream) {
+    CHECK_HIPFFT_ERROR(hipfftSetStream(handle, stream));
+    CHECK_HIPFFT_ERROR(hipfftSetWorkArea(handle, ws_ptr));
+    switch (transform_type) {
+      case FFTTransformType::C2C:
+        CHECK_HIPFFT_ERROR(hipfftExecC2C(
+            handle,
+            static_cast<hipfftComplex*>(in_ptr),
+            static_cast<hipfftComplex*>(out_ptr),
+            direction));
+        break;
+      case FFTTransformType::R2C:
+        CHECK_HIPFFT_ERROR(hipfftExecR2C(
+            handle,
+            static_cast<hipfftReal*>(in_ptr),
+            static_cast<hipfftComplex*>(out_ptr)));
+        break;
+      case FFTTransformType::C2R:
+        CHECK_HIPFFT_ERROR(hipfftExecC2R(
+            handle,
+            static_cast<hipfftComplex*>(in_ptr),
+            static_cast<hipfftReal*>(out_ptr)));
+        break;
+    }
+  });
+}
+
+void restore_output_layout(const OrderedArray& current, array& out) {
+  Strides out_strides(out.ndim());
+  for (size_t i = 0; i < current.order.size(); ++i) {
+    out_strides[current.order[i]] = current.arr.strides(i);
+  }
+
+  auto [data_size, row_contiguous, col_contiguous] =
+      check_contiguity(out.shape(), out_strides);
+  bool contiguous =
+      current.arr.flags().contiguous && data_size == current.arr.data_size();
+
+  out.copy_shared_buffer(
+      current.arr,
+      out_strides,
+      {contiguous, row_contiguous, col_contiguous},
+      current.arr.data_size());
+}
+
+void apply_inverse_scale(
+    array& arr,
+    const std::vector<size_t>& axes,
+    const array& out,
+    rocm::CommandEncoder& encoder) {
+  if (axes.empty()) {
+    return;
+  }
+
+  double scale = 1.0;
+  for (auto axis : axes) {
+    scale /= out.shape(axis);
+  }
+
+  size_t size = arr.data_size();
+  constexpr int block_size = 256;
+  int num_blocks = static_cast<int>(std::min<size_t>(
+      (size + block_size - 1) / block_size, 65535));
+
+  encoder.set_input_array(arr);
+  encoder.set_output_array(arr);
+
+  if (arr.dtype() == float32) {
+    float scale_f = static_cast<float>(scale);
+    encoder.add_kernel_node(
+        &rocm::scale_fft_output<float>,
+        dim3(num_blocks),
+        dim3(block_size),
+        0,
+        gpu_ptr<float>(arr),
+        scale_f,
+        size);
+  } else if (arr.dtype() == complex64) {
+    hipFloatComplex scale_f =
+        make_hipFloatComplex(static_cast<float>(scale), 0.0f);
+    encoder.add_kernel_node(
+        &rocm::scale_fft_output<hipFloatComplex>,
+        dim3(num_blocks),
+        dim3(block_size),
+        0,
+        gpu_ptr<hipFloatComplex>(arr),
+        scale_f,
+        size);
+  } else {
+    throw std::runtime_error("[FFT] Unsupported dtype for inverse scaling.");
+  }
+}
+
+} // namespace
+
+void FFT::eval_gpu(const std::vector<array>& inputs, array& out) {
+  auto& s = stream();
+  auto& encoder = rocm::get_command_encoder(s);
+  auto& in = inputs[0];
+
+  if (out.size() == 0) {
+    return;
+  }
+
+  auto order = make_identity_order(in.ndim());
+  OrderedArray current{in, std::move(order)};
+
+  std::vector<int> axis_sequence;
+  axis_sequence.reserve(axes_.size());
+  if (inverse_) {
+    for (auto axis : axes_) {
+      axis_sequence.push_back(static_cast<int>(axis));
+    }
+  } else {
+    for (int i = static_cast<int>(axes_.size()) - 1; i >= 0; --i) {
+      axis_sequence.push_back(static_cast<int>(axes_[i]));
+    }
+  }
+
+  int real_axis = axes_.empty() ? -1 : static_cast<int>(axes_.back());
+
+  for (size_t i = 0; i < axis_sequence.size(); ++i) {
+    int axis = axis_sequence[i];
+    bool step_real = real_ && axis == real_axis;
+    auto transform_type = step_real
+        ? (inverse_ ? FFTTransformType::C2R : FFTTransformType::R2C)
+        : FFTTransformType::C2C;
+
+    // hipFFT, like cuFFT, may overwrite its input for C2R, so the original
+    // input is only used directly when it is donatable to the output.
+    auto prepared = prepare_input(
+        current,
+        axis,
+        /* allow_direct = */ transform_type != FFTTransformType::C2R ||
+            is_donatable(in, out),
+        encoder,
+        s);
+
+    Shape step_shape = prepared.arr.shape();
+    if (step_real) {
+      // The output shape already encodes upstream's odd_out_ flag. Preserve
+      // that exact length for C2R (including odd lengths), not 2 * (in - 1).
+      // execute_fft keys the hipFFT plan and inverse scaling by this length.
+      step_shape.back() = out.shape(axis);
+    }
+
+    Dtype step_dtype =
+        transform_type == FFTTransformType::C2R ? float32 : complex64;
+    array step_out(std::move(step_shape), step_dtype, nullptr, {});
+    execute_fft(prepared.arr, step_out, transform_type, inverse_, encoder);
+    encoder.add_temporary(step_out);
+
+    current = {std::move(step_out), std::move(prepared.order)};
+  }
+
+  if (inverse_) {
+    apply_inverse_scale(current.arr, axes_, out, encoder);
+  }
+
+  restore_output_layout(current, out);
+}
+
+} // namespace mlx::core
diff --git a/mlx/backend/rocm/flash_attention.hip b/mlx/backend/rocm/flash_attention.hip
new file mode 100644
index 0000000..9e5d1de
--- /dev/null
+++ b/mlx/backend/rocm/flash_attention.hip
@@ -0,0 +1,671 @@
+// Copyright © 2025 Apple Inc.
+
+#define _USE_MATH_DEFINES
+
+#include "mlx/backend/gpu/copy.h"
+#include "mlx/backend/rocm/device.h"
+#include "mlx/backend/rocm/allocator.h"
+#include "mlx/backend/rocm/kernel_utils.hpp"
+#include "mlx/dtype_utils.h"
+
+#include <hip/hip_bfloat16.h>
+#include <hip/hip_runtime.h>
+#include <cmath>
+
+namespace mlx::core {
+namespace rocm {
+
+struct AttnParams {
+  int B;
+  int H;
+  int D_q; // Query/Key head dimension
+  int D_v; // Value head dimension
+  int qL;
+  int kL;
+  int gqa_factor;
+  float scale;
+  int64_t Q_strides[3];
+  int64_t K_strides[3];
+  int64_t V_strides[3];
+  int64_t O_strides[3];
+  int64_t M_strides[4]; // Mask strides [B, H, qL, kL]
+  bool has_mask;
+};
+
+// Standard flash attention kernel (D_q == D_v, no array mask)
+template <
+    typename T,
+    bool do_causal,
+    int D,
+    int BLOCK_M = 128,
+    int BLOCK_N = 64>
+__global__ __launch_bounds__(BLOCK_M) void kernel_sdpa_flash_opt(
+    const T* __restrict__ Q,
+    const T* __restrict__ K,
+    const T* __restrict__ V,
+    T* __restrict__ O,
+    const T* __restrict__ sinks,
+    const AttnParams params) {
+  // Grid: (H, ceil(qL / BLOCK_M), B)
+  // Block: (BLOCK_M, 1, 1) -> 128 threads
+
+  int batch_idx = blockIdx.z;
+  int head_idx = blockIdx.x;
+  int kv_head_idx = head_idx / params.gqa_factor;
+  int q_seq_start = blockIdx.y * BLOCK_M;
+  int thread_idx = threadIdx.x; // 0 to BLOCK_M - 1
+  int q_seq_idx = q_seq_start + thread_idx;
+
+  if (q_seq_start >= params.qL)
+    return;
+
+  const T* Q_ptr = Q + batch_idx * params.Q_strides[0] +
+      head_idx * params.Q_strides[1] + q_seq_idx * params.Q_strides[2];
+  T* O_ptr = O + batch_idx * params.O_strides[0] +
+      head_idx * params.O_strides[1] + q_seq_idx * params.O_strides[2];
+
+  bool valid_q = q_seq_idx < params.qL;
+
+  typedef float U;
+
+  // Registers for Q and O - use max of 256 for MLA value dimension
+  U q[256];
+  U o[256];
+
+  if (valid_q) {
+#pragma unroll
+    for (int i = 0; i < D; i++) {
+      q[i] = static_cast<U>(Q_ptr[i]);
+      o[i] = 0.f;
+    }
+  }
+
+  U max_score = -__int_as_float(0x7f7fffff); // -FLT_MAX
+  U sum_exp_score = 0.f;
+
+  if (sinks) {
+    max_score = static_cast<U>(sinks[head_idx]);
+    sum_exp_score = 1.f;
+  }
+
+  __shared__ T K_sh[BLOCK_N][D];
+  __shared__ T V_sh[BLOCK_N][D];
+
+  const int K_seq_len = params.kL;
+
+  for (int k_seq_start = 0; k_seq_start < K_seq_len; k_seq_start += BLOCK_N) {
+    if constexpr (do_causal) {
+      int earliest_valid_key = (K_seq_len - params.qL) + q_seq_start;
+      int block_end_key = k_seq_start + BLOCK_N - 1;
+      if (earliest_valid_key < block_end_key) {
+        int max_q_seq_idx = min(q_seq_start + BLOCK_M - 1, params.qL - 1);
+        int latest_valid_key = (K_seq_len - params.qL) + max_q_seq_idx;
+        if (latest_valid_key < k_seq_start) {
+          continue; // Block is completely causal-masked
+        }
+      }
+    }
+
+    __syncthreads();
+
+    // Collaborative loading of K_sh and V_sh
+    // BLOCK_N * D total elements = 64 * 128 = 8192.
+    // We have BLOCK_M = 128 threads.
+    // Each thread loads 8192 / 128 = 64 elements.
+    const int elements_per_thread = (BLOCK_N * D) / BLOCK_M;
+
+#pragma unroll
+    for (int i = 0; i < elements_per_thread; i++) {
+      int load_idx = i * BLOCK_M + thread_idx;
+      int r = load_idx / D;
+      int c = load_idx % D;
+      int k_idx = k_seq_start + r;
+      if (k_idx < K_seq_len) {
+        K_sh[r][c] =
+            K[batch_idx * params.K_strides[0] +
+              kv_head_idx * params.K_strides[1] + k_idx * params.K_strides[2] +
+              c];
+        V_sh[r][c] =
+            V[batch_idx * params.V_strides[0] +
+              kv_head_idx * params.V_strides[1] + k_idx * params.V_strides[2] +
+              c];
+      } else {
+        K_sh[r][c] = static_cast<T>(0.f);
+        V_sh[r][c] = static_cast<T>(0.f);
+      }
+    }
+
+    __syncthreads();
+
+    if (valid_q) {
+      // Loop over keys in the shared memory
+      for (int i = 0; i < BLOCK_N; i++) {
+        int k_idx = k_seq_start + i;
+        if (k_idx >= K_seq_len)
+          break;
+
+        bool use_key = true;
+        if constexpr (do_causal) {
+          use_key = k_idx <= (K_seq_len - params.qL + q_seq_idx);
+        }
+
+        if (use_key) {
+          U score = 0.f;
+
+#pragma unroll 16
+          for (int j = 0; j < D; j++) {
+            score += q[j] * static_cast<U>(K_sh[i][j]);
+          }
+
+          score *= params.scale;
+
+          U new_max = max(max_score, score);
+          U factor = expf(max_score - new_max);
+          U exp_score = expf(score - new_max);
+
+          max_score = new_max;
+          sum_exp_score = sum_exp_score * factor + exp_score;
+
+#pragma unroll 16
+          for (int j = 0; j < D; j++) {
+            o[j] = o[j] * factor + exp_score * static_cast<U>(V_sh[i][j]);
+          }
+        }
+      }
+    }
+  }
+
+  if (valid_q) {
+    U inv_sum = sum_exp_score == 0 ? 0.f : 1.0f / sum_exp_score;
+#pragma unroll 16
+    for (int i = 0; i < D; i++) {
+      O_ptr[i] = static_cast<T>(o[i] * inv_sum);
+    }
+  }
+}
+
+// MLA flash attention kernel with array mask support
+// Supports different Q and V dimensions and additive mask (pe_scores)
+// Note: BLOCK_N=32 to fit shared memory constraints (K_sh: 24KB + V_sh: 32KB =
+// 56KB < 64KB)
+template <
+    typename T,
+    bool do_causal,
+    int D_Q,
+    int D_V,
+    int BLOCK_M = 64,
+    int BLOCK_N = 32>
+__global__ __launch_bounds__(BLOCK_M) void kernel_sdpa_flash_mla(
+    const T* __restrict__ Q,
+    const T* __restrict__ K,
+    const T* __restrict__ V,
+    const T* __restrict__ mask, // Additive mask (pe_scores) [B, H, qL, kL]
+    T* __restrict__ O,
+    const T* __restrict__ sinks,
+    const AttnParams params) {
+  // Grid: (H, ceil(qL / BLOCK_M), B)
+  // Block: (BLOCK_M, 1, 1)
+
+  int batch_idx = blockIdx.z;
+  int head_idx = blockIdx.x;
+  int kv_head_idx = head_idx / params.gqa_factor;
+  int q_seq_start = blockIdx.y * BLOCK_M;
+  int thread_idx = threadIdx.x;
+  int q_seq_idx = q_seq_start + thread_idx;
+
+  if (q_seq_start >= params.qL)
+    return;
+
+  const T* Q_ptr = Q + batch_idx * params.Q_strides[0] +
+      head_idx * params.Q_strides[1] + q_seq_idx * params.Q_strides[2];
+  T* O_ptr = O + batch_idx * params.O_strides[0] +
+      head_idx * params.O_strides[1] + q_seq_idx * params.O_strides[2];
+
+  // Mask pointer for this query position
+  const T* M_ptr = params.has_mask
+      ? (mask + batch_idx * params.M_strides[0] +
+         head_idx * params.M_strides[1] + q_seq_idx * params.M_strides[2])
+      : nullptr;
+
+  bool valid_q = q_seq_idx < params.qL;
+
+  typedef float U;
+
+  // Registers for Q and O
+  U q[D_Q];
+  U o[D_V];
+
+  if (valid_q) {
+#pragma unroll
+    for (int i = 0; i < D_Q; i++) {
+      q[i] = static_cast<U>(Q_ptr[i]);
+    }
+#pragma unroll
+    for (int i = 0; i < D_V; i++) {
+      o[i] = 0.f;
+    }
+  }
+
+  U max_score = -__int_as_float(0x7f7fffff); // -FLT_MAX
+  U sum_exp_score = 0.f;
+
+  if (sinks) {
+    max_score = static_cast<U>(sinks[head_idx]);
+    sum_exp_score = 1.f;
+  }
+
+  __shared__ T K_sh[BLOCK_N][D_Q];
+  __shared__ T V_sh[BLOCK_N][D_V];
+
+  const int K_seq_len = params.kL;
+
+  for (int k_seq_start = 0; k_seq_start < K_seq_len; k_seq_start += BLOCK_N) {
+    if constexpr (do_causal) {
+      int earliest_valid_key = (K_seq_len - params.qL) + q_seq_start;
+      int block_end_key = k_seq_start + BLOCK_N - 1;
+      if (earliest_valid_key < block_end_key) {
+        int max_q_seq_idx = min(q_seq_start + BLOCK_M - 1, params.qL - 1);
+        int latest_valid_key = (K_seq_len - params.qL) + max_q_seq_idx;
+        if (latest_valid_key < k_seq_start) {
+          continue;
+        }
+      }
+    }
+
+    __syncthreads();
+
+    // Collaborative loading of K_sh (D_Q elements per row)
+    {
+      const int total_k_elements = BLOCK_N * D_Q;
+      const int k_per_thread = (total_k_elements + BLOCK_M - 1) / BLOCK_M;
+#pragma unroll
+      for (int i = 0; i < k_per_thread; i++) {
+        int load_idx = i * BLOCK_M + thread_idx;
+        if (load_idx < total_k_elements) {
+          int r = load_idx / D_Q;
+          int c = load_idx % D_Q;
+          int k_idx = k_seq_start + r;
+          if (k_idx < K_seq_len) {
+            K_sh[r][c] =
+                K[batch_idx * params.K_strides[0] +
+                  kv_head_idx * params.K_strides[1] +
+                  k_idx * params.K_strides[2] + c];
+          } else {
+            K_sh[r][c] = static_cast<T>(0.f);
+          }
+        }
+      }
+    }
+
+    // Collaborative loading of V_sh (D_V elements per row)
+    {
+      const int total_v_elements = BLOCK_N * D_V;
+      const int v_per_thread = (total_v_elements + BLOCK_M - 1) / BLOCK_M;
+#pragma unroll
+      for (int i = 0; i < v_per_thread; i++) {
+        int load_idx = i * BLOCK_M + thread_idx;
+        if (load_idx < total_v_elements) {
+          int r = load_idx / D_V;
+          int c = load_idx % D_V;
+          int k_idx = k_seq_start + r;
+          if (k_idx < K_seq_len) {
+            V_sh[r][c] =
+                V[batch_idx * params.V_strides[0] +
+                  kv_head_idx * params.V_strides[1] +
+                  k_idx * params.V_strides[2] + c];
+          } else {
+            V_sh[r][c] = static_cast<T>(0.f);
+          }
+        }
+      }
+    }
+
+    __syncthreads();
+
+    if (valid_q) {
+// Loop over keys in the shared memory
+#pragma unroll 4
+      for (int i = 0; i < BLOCK_N; i++) {
+        int k_idx = k_seq_start + i;
+        if (k_idx >= K_seq_len)
+          break;
+
+        bool use_key = true;
+        if constexpr (do_causal) {
+          use_key = k_idx <= (K_seq_len - params.qL + q_seq_idx);
+        }
+
+        if (use_key) {
+          // Compute Q @ K score
+          U score = 0.f;
+
+#pragma unroll 16
+          for (int j = 0; j < D_Q; j++) {
+            score += q[j] * static_cast<U>(K_sh[i][j]);
+          }
+
+          score *= params.scale;
+
+          // Add mask bias (pe_scores) if present
+          if (M_ptr) {
+            score += static_cast<U>(M_ptr[k_idx * params.M_strides[3]]);
+          }
+
+          U new_max = max(max_score, score);
+          U factor = expf(max_score - new_max);
+          U exp_score = expf(score - new_max);
+
+          max_score = new_max;
+          sum_exp_score = sum_exp_score * factor + exp_score;
+
+#pragma unroll 16
+          for (int j = 0; j < D_V; j++) {
+            o[j] = o[j] * factor + exp_score * static_cast<U>(V_sh[i][j]);
+          }
+        }
+      }
+    }
+  }
+
+  if (valid_q) {
+    U inv_sum = sum_exp_score == 0 ? 0.f : 1.0f / sum_exp_score;
+#pragma unroll 16
+    for (int i = 0; i < D_V; i++) {
+      O_ptr[i] = static_cast<T>(o[i] * inv_sum);
+    }
+  }
+}
+
+} // namespace rocm
+
+bool supports_sdpa_flash(
+    const array& q,
+    const array& k,
+    const array& v,
+    bool has_mask,
+    bool has_arr_mask,
+    bool do_causal,
+    bool output_logsumexp) {
+  if (output_logsumexp) {
+    return false;
+  }
+  if (q.dtype() != float32 && q.dtype() != float16 && q.dtype() != bfloat16) {
+    return false;
+  }
+  const int D_q = q.shape(-1);
+  const int D_v = v.shape(-1);
+
+  // Standard attention dimensions (D_q == D_v)
+  bool standard_dims = (D_q == 64 || D_q == 96 || D_q == 128 || D_q == 256);
+
+  // MLA attention dimensions (D_q=192, D_v=256)
+  bool mla_dims = (D_q == 192 && D_v == 256);
+
+  if (D_q == D_v && standard_dims) {
+    if (D_q == 256 && q.dtype() == float32) {
+      return false;
+    }
+    // Standard attention: no array mask needed for flash kernel
+    return !has_arr_mask;
+  } else if (mla_dims) {
+    // MLA attention: supports array mask (additive bias)
+    return true;
+  }
+  return false;
+}
+
+void sdpa_flash(
+    const array& q,
+    const array& k,
+    const array& v,
+    float scale,
+    array& o,
+    bool do_causal,
+    const std::optional<array>& mask,
+    const std::optional<array>& sinks,
+    Stream s) {
+  auto& d = rocm::device(s.device);
+  auto& encoder = d.get_command_encoder(s);
+
+  int B = q.shape(0);
+  int H = q.shape(1);
+  int qL = q.shape(2);
+  int kL = k.shape(2);
+  int D_q = q.shape(3);
+  int D_v = v.shape(3);
+  int gqa_factor = q.shape(1) / k.shape(1);
+
+  o.set_data(mlx::core::rocm::malloc_async(o.nbytes(), encoder));
+
+  rocm::AttnParams params;
+  params.B = B;
+  params.H = H;
+  params.D_q = D_q;
+  params.D_v = D_v;
+  params.qL = qL;
+  params.kL = kL;
+  params.gqa_factor = gqa_factor;
+  params.scale = scale;
+  params.Q_strides[0] = q.strides(0);
+  params.Q_strides[1] = q.strides(1);
+  params.Q_strides[2] = q.strides(2);
+  params.K_strides[0] = k.strides(0);
+  params.K_strides[1] = k.strides(1);
+  params.K_strides[2] = k.strides(2);
+  params.V_strides[0] = v.strides(0);
+  params.V_strides[1] = v.strides(1);
+  params.V_strides[2] = v.strides(2);
+  params.O_strides[0] = o.strides(0);
+  params.O_strides[1] = o.strides(1);
+  params.O_strides[2] = o.strides(2);
+
+  params.has_mask = mask.has_value();
+  if (mask) {
+    params.M_strides[0] = mask->strides(0);
+    params.M_strides[1] = mask->strides(1);
+    params.M_strides[2] = mask->strides(2);
+    params.M_strides[3] = mask->strides(3);
+  }
+
+  bool has_sinks = sinks.has_value();
+  bool has_mask_val = mask.has_value();
+  bool is_mla = (D_q == 192 && D_v == 256);
+
+  encoder.set_input_array(q);
+  encoder.set_input_array(k);
+  encoder.set_input_array(v);
+  if (mask) {
+    encoder.set_input_array(*mask);
+  }
+  if (sinks) {
+    encoder.set_input_array(*sinks);
+  }
+  encoder.set_output_array(o);
+
+  {
+    if (is_mla) {
+      // MLA kernel with D_q=192, D_v=256
+      // Use BLOCK_N=32 to fit shared memory (K_sh: 24KB + V_sh: 32KB = 56KB <
+      // 64KB limit)
+      constexpr int BLOCK_M = 64;
+      constexpr int BLOCK_N = 32;
+      int grid_y = (qL + BLOCK_M - 1) / BLOCK_M;
+      dim3 grid_dim(H, grid_y, B);
+      dim3 block_dim(BLOCK_M, 1, 1);
+
+      auto launch_mla_kernel = [&](auto type_tag, auto causal_tag) {
+        using DataType = decltype(type_tag);
+        constexpr bool causal = decltype(causal_tag)::value;
+
+        encoder.add_kernel_node(
+            &rocm::kernel_sdpa_flash_mla<
+                DataType,
+                causal,
+                192,
+                256,
+                BLOCK_M,
+                BLOCK_N>,
+            grid_dim,
+            block_dim,
+            0,
+            gpu_ptr<DataType>(q),
+            gpu_ptr<DataType>(k),
+            gpu_ptr<DataType>(v),
+            has_mask_val ? gpu_ptr<DataType>(*mask) : nullptr,
+            gpu_ptr<DataType>(o),
+            has_sinks ? gpu_ptr<DataType>(*sinks) : nullptr,
+            params);
+      };
+
+      if (o.dtype() == float32) {
+        if (do_causal)
+          launch_mla_kernel(float(), std::true_type());
+        else
+          launch_mla_kernel(float(), std::false_type());
+      } else if (o.dtype() == float16) {
+        if (do_causal)
+          launch_mla_kernel(__half(), std::true_type());
+        else
+          launch_mla_kernel(__half(), std::false_type());
+      } else if (o.dtype() == bfloat16) {
+        if (do_causal)
+          launch_mla_kernel(hip_bfloat16(), std::true_type());
+        else
+          launch_mla_kernel(hip_bfloat16(), std::false_type());
+      }
+    } else {
+      // Standard flash attention kernel
+      constexpr int BLOCK_M = 128;
+      constexpr int BLOCK_N = 64;
+      int grid_y = (qL + BLOCK_M - 1) / BLOCK_M;
+      dim3 grid_dim(H, grid_y, B);
+      dim3 block_dim(BLOCK_M, 1, 1);
+
+      auto launch_kernel =
+          [&](auto type_tag, auto causal_tag, auto headdim_tag) {
+            using DataType = decltype(type_tag);
+            constexpr bool causal = decltype(causal_tag)::value;
+            constexpr int headdim = decltype(headdim_tag)::value;
+
+            encoder.add_kernel_node(
+                &rocm::kernel_sdpa_flash_opt<
+                    DataType,
+                    causal,
+                    headdim,
+                    BLOCK_M,
+                    BLOCK_N>,
+                grid_dim,
+                block_dim,
+                0,
+                gpu_ptr<DataType>(q),
+                gpu_ptr<DataType>(k),
+                gpu_ptr<DataType>(v),
+                gpu_ptr<DataType>(o),
+                has_sinks ? gpu_ptr<DataType>(*sinks) : nullptr,
+                params);
+          };
+
+      if (o.dtype() == float32) {
+        if (do_causal) {
+          if (D_q == 64)
+            launch_kernel(
+                float(), std::true_type(), std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                float(), std::true_type(), std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                float(), std::true_type(), std::integral_constant<int, 128>());
+        } else {
+          if (D_q == 64)
+            launch_kernel(
+                float(), std::false_type(), std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                float(), std::false_type(), std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                float(), std::false_type(), std::integral_constant<int, 128>());
+        }
+      } else if (o.dtype() == float16) {
+        if (do_causal) {
+          if (D_q == 64)
+            launch_kernel(
+                __half(), std::true_type(), std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                __half(), std::true_type(), std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                __half(), std::true_type(), std::integral_constant<int, 128>());
+          else if (D_q == 256)
+            launch_kernel(
+                __half(), std::true_type(), std::integral_constant<int, 256>());
+        } else {
+          if (D_q == 64)
+            launch_kernel(
+                __half(), std::false_type(), std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                __half(), std::false_type(), std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                __half(),
+                std::false_type(),
+                std::integral_constant<int, 128>());
+          else if (D_q == 256)
+            launch_kernel(
+                __half(),
+                std::false_type(),
+                std::integral_constant<int, 256>());
+        }
+      } else if (o.dtype() == bfloat16) {
+        if (do_causal) {
+          if (D_q == 64)
+            launch_kernel(
+                hip_bfloat16(),
+                std::true_type(),
+                std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                hip_bfloat16(),
+                std::true_type(),
+                std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                hip_bfloat16(),
+                std::true_type(),
+                std::integral_constant<int, 128>());
+          else if (D_q == 256)
+            launch_kernel(
+                hip_bfloat16(),
+                std::true_type(),
+                std::integral_constant<int, 256>());
+        } else {
+          if (D_q == 64)
+            launch_kernel(
+                hip_bfloat16(),
+                std::false_type(),
+                std::integral_constant<int, 64>());
+          else if (D_q == 96)
+            launch_kernel(
+                hip_bfloat16(),
+                std::false_type(),
+                std::integral_constant<int, 96>());
+          else if (D_q == 128)
+            launch_kernel(
+                hip_bfloat16(),
+                std::false_type(),
+                std::integral_constant<int, 128>());
+          else if (D_q == 256)
+            launch_kernel(
+                hip_bfloat16(),
+                std::false_type(),
+                std::integral_constant<int, 256>());
+        }
+      }
+    }
+  }
+}
+
