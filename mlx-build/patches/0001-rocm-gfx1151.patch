+namespace {
+
+template <typename T>
+struct nvfp4_type_tag {
+  using type = T;
+};
+
+// Throws unless (bits, group_size) is NVFP4's 4-bit, group-16 layout and the
+// quantized axis (K for a transposed weight, N otherwise) splits into whole
+// groups.
+inline void check_nvfp4_layout(
+    const char* who,
+    int bits,
+    int group_size,
+    int quantized_axis) {
+  if (bits != 4 || group_size != rocm::kNvfp4GroupSize) {
+    throw std::runtime_error(
+        std::string(who) +
+        " nvfp4 requires bits 4 and group_size 16; got bits=" +
+        std::to_string(bits) + " group_size=" + std::to_string(group_size));
+  }
+  if (quantized_axis % rocm::kNvfp4GroupSize != 0) {
+    throw std::runtime_error(
+        std::string(who) +
+        " nvfp4 requires the quantized axis to be a multiple of 16; got " +
+        std::to_string(quantized_axis));
+  }
+}
+
+// Throws unless `scales` holds exactly one byte per 16 packed values of `w`
+// in w's layout: the same rank, the same leading dims, and a last axis of
+// w.shape(-1) / 2. MLX's validate_quantized_input checks only the batch
+// prefix and the last axis, so a scale plane from a malformed checkpoint can
+// carry a short row axis or an extra leading axis; the kernels index scales
+// as [..., rows, K / 16] and would read (or, in nvfp4_dequantize_kernel,
+// write) past a buffer sized from the other operand.
+inline void check_nvfp4_planes(
+    const char* who,
+    const array& w,
+    const array& scales) {
+  bool ok = w.ndim() >= 2 && scales.ndim() == w.ndim() &&
+      static_cast<int64_t>(scales.shape(-1)) * rocm::kNvfp4WordsPerGroup ==
+          static_cast<int64_t>(w.shape(-1));
+  for (int i = 0; ok && i + 1 < static_cast<int>(w.ndim()); ++i) {
+    ok = scales.shape(i) == w.shape(i);
+  }
+  if (!ok || scales.itemsize() != 1) {
+    throw std::runtime_error(
+        std::string(who) +
+        " nvfp4 scales must be one uint8 per 16 values in the weight's "
+        "layout (scales.shape == w.shape[:-1] + [w.shape[-1] / 2])");
+  }
+}
+
+// Dequantizes the NVFP4 plane (w, scales) into `out`, which has w's shape
+// with the packed last axis expanded and the activation dtype. The group
+// count comes from w and both other buffers are checked against it, so a
+// mismatched plane throws instead of writing past `out`.
+inline void nvfp4_dequantize_dense(
+    rocm::CommandEncoder& enc,
+    const array& w,
+    const array& scales,
+    array& out) {
+  const int64_t num_groups =
+      static_cast<int64_t>(w.size()) / rocm::kNvfp4WordsPerGroup;
+  if (static_cast<int64_t>(scales.size()) != num_groups ||
+      static_cast<int64_t>(out.size()) != num_groups * rocm::kNvfp4GroupSize) {
+    throw std::runtime_error(
+        "[nvfp4] dequantize plane sizes disagree: w=" +
+        std::to_string(w.size()) + " scales=" + std::to_string(scales.size()) +
+        " out=" + std::to_string(out.size()));
+  }
+  constexpr int block = 256;
+  const uint32_t blocks = rocm::copy_grid_blocks(num_groups, block);
+  auto launch = [&](auto type_tag) {
+    using T = typename decltype(type_tag)::type;
+    enc.add_kernel_node(
+        &rocm::nvfp4_dequantize_kernel<T>,
+        dim3(blocks),
+        dim3(block),
+        0u,
+        gpu_ptr<const uint32_t>(w),
+        gpu_ptr<const uint8_t>(scales),
+        gpu_ptr<T>(out),
+        num_groups);
+  };
+  switch (out.dtype()) {
+    case float32:
+      launch(nvfp4_type_tag<float>{});
+      break;
+    case float16:
+      launch(nvfp4_type_tag<__half>{});
+      break;
+    case bfloat16:
+      launch(nvfp4_type_tag<hip_bfloat16>{});
+      break;
+    default:
+      throw std::runtime_error("[nvfp4] unsupported dequantize dtype");
+  }
+}
+
+// Everything nvfp4_qmv_kernel reads besides the operands themselves.
+struct Nvfp4QmvArgs {
+  const uint32_t* lhs_indices = nullptr; // null for QuantizedMatmul
+  const uint32_t* rhs_indices = nullptr;
+  rocm::Shape batch_shape{};
+  rocm::Strides lhs_idx_strides{};
+  rocm::Strides rhs_idx_strides{};
+  int batch_ndim = 0;
+  int64_t rows = 0; // batch * M
+  int M = 0;
+  int N = 0;
+  int K = 0;
+  int E = 1;
+  int64_t x_batch_stride = 0; // dense only
+  bool w_batched = false; // dense only
+  bool multi_row = false; // ROWS = 8 instead of 1
+};
+
+inline void nvfp4_qmv(
+    rocm::CommandEncoder& enc,
+    const array& x,
+    const array& w,
+    const array& scales,
+    const float* global_scale,
+    array& out,
+    const Nvfp4QmvArgs& a) {
+  if (a.rows == 0 || a.N == 0) {
+    return;
+  }
+  const int rows_per_block = a.multi_row ? 8 : 1;
+  const int64_t grid_x = (a.rows + rows_per_block - 1) / rows_per_block;
+  const int64_t grid_y =
+      (a.N + rocm::kNvfp4ColsPerBlock - 1) / rocm::kNvfp4ColsPerBlock;
+  // HIP bounds the work items of a grid dimension (blocks times threads) by
+  // UINT32_MAX, so grid x tops out at UINT32_MAX / kNvfp4LanesPerCol blocks,
+  // not at INT32_MAX (the limit items 11 and 62 work around).
+  constexpr int64_t kMaxGridX =
+      std::numeric_limits<uint32_t>::max() / rocm::kNvfp4LanesPerCol;
+  if (grid_x > kMaxGridX || grid_y > 65535) {
+    throw std::runtime_error(
+        "[nvfp4] output too large for one launch: rows=" +
+        std::to_string(a.rows) + " N=" + std::to_string(a.N));
+  }
+  dim3 grid(static_cast<uint32_t>(grid_x), static_cast<uint32_t>(grid_y));
+  dim3 block(rocm::kNvfp4LanesPerCol, rocm::kNvfp4ColsPerBlock);
+  auto launch = [&](auto type_tag, auto rows_tag) {
+    using T = typename decltype(type_tag)::type;
+    constexpr int ROWS = decltype(rows_tag)::value;
+    enc.add_kernel_node(
+        &rocm::nvfp4_qmv_kernel<T, ROWS>,
+        grid,
+        block,
+        0u,
+        gpu_ptr<const T>(x),
+        gpu_ptr<const uint32_t>(w),
+        gpu_ptr<const uint8_t>(scales),
+        global_scale,
+        a.lhs_indices,
+        a.rhs_indices,
+        a.batch_shape,
+        a.lhs_idx_strides,
+        a.rhs_idx_strides,
+        a.batch_ndim,
+        gpu_ptr<T>(out),
+        a.rows,
+        a.M,
+        a.N,
+        a.K,
+        a.E,
+        a.x_batch_stride,
+        a.w_batched);
+  };
+  auto by_rows = [&](auto type_tag) {
+    if (a.multi_row) {
+      launch(type_tag, std::integral_constant<int, 8>{});
+    } else {
+      launch(type_tag, std::integral_constant<int, 1>{});
+    }
+  };
+  switch (x.dtype()) {
+    case float32:
+      by_rows(nvfp4_type_tag<float>{});
+      break;
+    case float16:
+      by_rows(nvfp4_type_tag<__half>{});
+      break;
+    case bfloat16:
+      by_rows(nvfp4_type_tag<hip_bfloat16>{});
+      break;
+    default:
+      throw std::runtime_error("[nvfp4] unsupported activation dtype");
+  }
+}
+
+} // namespace
+
+} // namespace mlx::core
diff --git a/mlx/backend/rocm/quantized/qdequant.hpp b/mlx/backend/rocm/quantized/qdequant.hpp
new file mode 100644
index 0000000..65061d3
--- /dev/null
+++ b/mlx/backend/rocm/quantized/qdequant.hpp
@@ -0,0 +1,223 @@
+// Shared dequantization utilities for optimized QMM kernels.
+// Used by qmv_tiled_kernel.hip (the tiled dense and gather QMV kernels),
+// nvfp4_qmv.hip (the NVFP4 kernels) and qmm.hip.
+
+#pragma once
+
+#include <hip/hip_bfloat16.h>
+#include <hip/hip_fp16.h>
+#include <hip/hip_runtime.h>
+#include "mlx/backend/rocm/device/config.h"
+
+namespace mlx::core::rocm {
+
+// --- Compile-time constants ---
+
+// Number of quantized values packed per uint32 word.
+// 4-bit: 8 values, 2-bit: 16 values, 8-bit: 4 values.
+template <int BITS>
+inline constexpr int pack_factor_u32 = 32 / BITS;
+
+// Number of uint32 words each thread loads per K-iteration.
+// Chosen so that values_per_thread = 16 for all bit widths.
+template <int BITS>
+inline constexpr int packs_per_thread = 16 / pack_factor_u32<BITS>;
+// 4-bit: 16/8=2, 2-bit: 16/16=1, 8-bit: 16/4=4
+
+// Number of quantized values each thread processes per K-iteration.
+template <int BITS>
+inline constexpr int values_per_thread = 16;
+
+// Number of K-elements consumed per warp per iteration.
+// = values_per_thread * WARP_SIZE = 16 * 32 = 512
+inline constexpr int block_size_k = values_per_thread<4> * WARP_SIZE;
+
+// Number of output rows computed per thread block.
+inline constexpr int ROWS_PER_BLOCK = 8;
+
+// --- Warp reduction ---
+
+__device__ __forceinline__ float warp_reduce_sum(float val) {
+#pragma unroll
+  for (int offset = WARP_SIZE / 2; offset > 0; offset /= 2) {
+    val += __shfl_xor(val, offset);
+  }
+  return val;
+}
+
+// --- Dequant-and-dot: integer dot product + x-sum accumulation ---
+//
+// Metal-compatible accumulation: accumulates raw integer dot product and
+// x-sum separately. The caller applies scale and bias ONCE per group:
+//   result += scale * total_qdot + bias * total_xsum
+//
+// This matches Metal's qdot() which returns scale * accum + sum * bias,
+// where accum and sum span all values_per_thread elements at once.
+//
+// The naive per-element form `acc += x[i] * (scale * q[i] + bias)` is
+// mathematically equivalent but produces different float32 rounding due to
+// a different number of scale/bias multiply operations, causing LLM output
+// to degenerate into repetitive loops after ~10 tokens.
+
+template <int BITS>
+__device__ __forceinline__ void dequant_and_dot(
+    uint32_t packed,
+    const float* __restrict__ x_local,
+    float& qdot_acc,
+    float& x_sum) {
+  constexpr int pf = pack_factor_u32<BITS>;
+  constexpr uint32_t mask = (1u << BITS) - 1u;
+
+#pragma unroll
+  for (int i = 0; i < pf; i++) {
+    float q = static_cast<float>((packed >> (i * BITS)) & mask);
+    qdot_acc += x_local[i] * q;
+    x_sum += x_local[i];
+  }
+}
+
+// GEMV variant: 4 independent qdot partials (dual-issue-friendly). Caller
+// reduces them and applies scale/bias once per group — same result as
+// dequant_and_dot.
+template <int BITS>
+__device__ __forceinline__ void dequant_and_dot4(
+    uint32_t packed,
+    const float* __restrict__ x_local,
+    float (&qdot)[4],
+    float& x_sum) {
+  constexpr int pf = pack_factor_u32<BITS>;
+  constexpr uint32_t mask = (1u << BITS) - 1u;
+
+#pragma unroll
+  for (int i = 0; i < pf; i++) {
+    float q = static_cast<float>((packed >> (i * BITS)) & mask);
+    qdot[i & 3] += x_local[i] * q;
+    x_sum += x_local[i];
+  }
+}
+
+__device__ __forceinline__ float reduce_qdot4(const float (&qdot)[4]) {
+  return (qdot[0] + qdot[1]) + (qdot[2] + qdot[3]);
+}
+
+// --- Vectorized weight load ---
+//
+// Loads PPT uint32 words in a single wide memory transaction instead of
+// PPT scalar loads. For 4-bit (PPT=2), emits global_load_dwordx2 (64-bit).
+// For 8-bit (PPT=4), emits global_load_dwordx4 (128-bit).
+// Pointer must be naturally aligned (8-byte for uint2, 16-byte for uint4).
+
+template <int BITS>
+__device__ __forceinline__ void load_weight_vec(
+    const uint32_t* __restrict__ ptr,
+    uint32_t (&out)[packs_per_thread<BITS>]) {
+  constexpr int PPT = packs_per_thread<BITS>;
+  if constexpr (PPT == 2) {
+    uint2 v = *reinterpret_cast<const uint2*>(ptr);
+    out[0] = v.x;
+    out[1] = v.y;
+  } else if constexpr (PPT == 4) {
+    uint4 v = *reinterpret_cast<const uint4*>(ptr);
+    out[0] = v.x;
+    out[1] = v.y;
+    out[2] = v.z;
+    out[3] = v.w;
+  } else {
+#pragma unroll
+    for (int p = 0; p < PPT; p++) {
+      out[p] = ptr[p];
+    }
+  }
+}
+
+// Non-temporal weight load for GEMV: weights are read once, so emit streaming
+// (slc) loads that bypass L2, leaving it for the reused X/scales. GEMV-only.
+// Widened to vector transactions (was PPT scalar loads): 4-bit (PPT=2) -> one
+// b64, 8-bit (PPT=4) -> one b128. A single b128 is correct on RDNA 3.5
+// (gfx1151, hipcc 7.13) — verified bit-identical 8-bit affine decode — so no
+// arch split. Fewer, wider loads raise memory-level parallelism on the
+// latency-bound M=1 decode matvec.
+template <int BITS>
+__device__ __forceinline__ void load_weight_vec_streaming(
+    const uint32_t* __restrict__ ptr,
+    uint32_t (&out)[packs_per_thread<BITS>]) {
+  constexpr int PPT = packs_per_thread<BITS>;
+  // Scalar nontemporal loads — the compiler coalesces adjacent ones. The old
+  // uint2/uint4 vector-typed __builtin_nontemporal_load hack is rejected by the
+  // clang toolchain (nontemporal builtin not valid on vector types).
+#pragma unroll
+  for (int p = 0; p < PPT; p++) {
+    out[p] = __builtin_nontemporal_load(ptr + p);
+  }
+}
+
+// --- Block-float element and scale decode ---
+//
+// mlxcelverse: an fp4 (e2m1) nibble decoded without a branch, as its value
+// times 2^-14. The sign bit and the three magnitude bits (two exponent bits,
+// one mantissa bit) land in an fp16's sign bit, low exponent bits and top
+// mantissa bit, so exponent 0 becomes the fp16 subnormal 0 or 2^-15 and the
+// rest are normal; v_cvt_f32_f16 widens both exactly. Callers multiply the
+// accumulated dot product by 2^14 (kFp4HalfBitsScale), which is exact.
+constexpr float kFp4HalfBitsScale = 16384.0f;
+__device__ __forceinline__ float fp4_e2m1_to_float_scaled(uint32_t nibble) {
+  const uint16_t h =
+      static_cast<uint16_t>(((nibble & 0x8u) << 12) | ((nibble & 0x7u) << 9));
+  return static_cast<float>(__builtin_bit_cast(_Float16, h));
+}
+
+// mlxcelverse: an E4M3 byte (the NVFP4 block scale; bias 7, no infinities)
+// decoded without a branch, as its value times 2^-8 (lablup/mlxcel#2617). The
+// sign moves to the fp16 sign bit and the seven exponent and mantissa bits
+// land in the fp16's low five exponent bits and top three mantissa bits, so
+// the fp16 exponent bias of 15 reads every normal E4M3 value 2^8 too small,
+// and an E4M3 subnormal (exponent 0, value m * 2^-9) becomes the fp16
+// subnormal m * 2^-17, the same 2^-8 ratio. Every result is exact. The E8M0
+// scale of mxfp4/mxfp8 is decoded by fp_scale_to_float in qmm.hip. Callers
+// multiply by 2^8 (kE4m3HalfBitsScale), which is exact; e4m3_to_float does it
+// for them. 0x7F and 0xFF, E4M3's NaN, decode as +-480; MLX's quantizer never
+// emits them.
+constexpr float kE4m3HalfBitsScale = 256.0f;
+__device__ __forceinline__ float e4m3_to_float_scaled(uint32_t byte) {
+  const uint16_t h =
+      static_cast<uint16_t>(((byte & 0x80u) << 8) | ((byte & 0x7Fu) << 7));
+  return static_cast<float>(__builtin_bit_cast(_Float16, h));
+}
+
+__device__ __forceinline__ float e4m3_to_float(uint32_t byte) {
+  return e4m3_to_float_scaled(byte) * kE4m3HalfBitsScale;
+}
+
+// --- Type conversion helpers ---
+
+__device__ __forceinline__ float to_float(__half x) {
+  return __half2float(x);
+}
+
+__device__ __forceinline__ float to_float(hip_bfloat16 x) {
+  return static_cast<float>(x);
+}
+
+__device__ __forceinline__ float to_float(float x) {
+  return x;
+}
+
+template <typename T>
+__device__ __forceinline__ T from_float(float x);
+
+template <>
+__device__ __forceinline__ __half from_float<__half>(float x) {
+  return __float2half(x);
+}
+
+template <>
+__device__ __forceinline__ hip_bfloat16 from_float<hip_bfloat16>(float x) {
+  return hip_bfloat16(x);
+}
+
+template <>
+__device__ __forceinline__ float from_float<float>(float x) {
+  return x;
+}
+
+} // namespace mlx::core::rocm
