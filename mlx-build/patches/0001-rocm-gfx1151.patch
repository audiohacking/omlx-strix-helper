+// ======================================================================
+// mlxcelverse: expert-batched NVFP4 gather QMV for a sorted prefill
+// (lablup/mlxcel#2665).
+//
+// nvfp4_qmv_kernel's multi-row arm shares one weight-group load across eight
+// consecutive rows, but every 16-column block re-reads each activation row,
+// so a prefill reads its activations about N / 16 times. Here block z is
+// expert z: it finds that expert's run of the sorted rhs indices with
+// find_sorted_expert_run and walks the run TOKENS rows at a time, and each
+// 16-lane group computes COLS adjacent columns from one load of each
+// activation group, which divides the activation traffic by COLS. Block
+// z == E zeroes the rows routed at or past E, which sort to the end. The
+// global scale enters each output once, as in nvfp4_qmv_kernel.
+//
+// M == 1 (the gate's condition): output row b is x row lhs[b].
+//
+// Grid: (ceil(N / (kNvfp4ColsPerBlock * COLS)), 1, E + 1).
+// Block: (kNvfp4LanesPerCol, kNvfp4ColsPerBlock).
+// ======================================================================
+template <typename T, int TOKENS, int COLS>
+__global__ void __launch_bounds__(kNvfp4LanesPerCol * kNvfp4ColsPerBlock)
+    nvfp4_gather_expert_batched_kernel(
+        const T* __restrict__ x,
+        const uint32_t* __restrict__ w,
+        const uint8_t* __restrict__ scales,
+        const float* __restrict__ global_scale,
+        const uint32_t* __restrict__ lhs_indices,
+        const uint32_t* __restrict__ rhs_indices, // SORTED
+        const rocm::Shape batch_shape,
+        const rocm::Strides lhs_idx_strides,
+        const rocm::Strides rhs_idx_strides,
+        int batch_ndim,
+        T* __restrict__ out,
+        int B,
+        int N,
+        int K,
+        int E) {
+  const int lane = threadIdx.x;
+  const int col0 = (blockIdx.x * kNvfp4ColsPerBlock + threadIdx.y) * COLS;
+  const uint32_t expert = blockIdx.z;
+
+  __shared__ int s_run_start, s_run_end;
+  if (lane == 0 && threadIdx.y == 0) {
+    int rs, re;
+    find_sorted_expert_run(
+        rhs_indices, batch_shape, rhs_idx_strides, batch_ndim, B, expert, rs,
+        re);
+    s_run_start = rs;
+    // Block E takes every row whose expert is E or larger.
+    s_run_end = expert < static_cast<uint32_t>(E) ? re : B;
+  }
+  __syncthreads();
+  const int run_start = s_run_start;
+  const int run_end = s_run_end;
+  if (col0 >= N || run_end <= run_start) {
+    return; // the whole 16-lane group leaves together
+  }
+  const int ncols = min(COLS, N - col0);
+  if (expert >= static_cast<uint32_t>(E)) {
+    for (int b = run_start + lane; b < run_end; b += kNvfp4LanesPerCol) {
+      for (int c = 0; c < ncols; ++c) {
+        out[static_cast<int64_t>(b) * N + col0 + c] = from_float<T>(0.0f);
+      }
+    }
+    return;
+  }
+
+  const int64_t words_per_row = K / 8;
+  const int64_t groups_per_row = K / kNvfp4GroupSize;
+  // Columns past N repeat the last valid one; their sums are not stored.
+  const uint32_t* w_row[COLS];
+  const uint8_t* s_row[COLS];
+#pragma unroll
+  for (int c = 0; c < COLS; ++c) {
+    const int64_t col = col0 + min(c, ncols - 1);
+    w_row[c] = w + static_cast<int64_t>(expert) * N * words_per_row +
+        col * words_per_row;
+    s_row[c] = scales + static_cast<int64_t>(expert) * N * groups_per_row +
+        col * groups_per_row;
+  }
+  const float factor = nvfp4_output_factor(global_scale, expert);
+
+  for (int b0 = run_start; b0 < run_end; b0 += TOKENS) {
+    const int count = min(TOKENS, run_end - b0);
+    const T* x_row[TOKENS];
+    float acc[TOKENS][COLS];
+#pragma unroll
+    for (int t = 0; t < TOKENS; ++t) {
+      // Rows past the run repeat the first one; their sums are not stored.
+      const int b = t < count ? b0 + t : b0;
+      const uint32_t xi = lhs_indices[gather_index_loc(
+          b, batch_shape, lhs_idx_strides, batch_ndim)];
+      x_row[t] = x + static_cast<int64_t>(xi) * K;
+#pragma unroll
+      for (int c = 0; c < COLS; ++c) {
+        acc[t][c] = 0.0f;
+      }
+    }
+    for (int64_t g = lane; g < groups_per_row; g += kNvfp4LanesPerCol) {
+      float wv[COLS][kNvfp4GroupSize];
+      float scale[COLS];
+#pragma unroll
+      for (int c = 0; c < COLS; ++c) {
+        const uint32_t w0 = w_row[c][g * kNvfp4WordsPerGroup];
+        const uint32_t w1 = w_row[c][g * kNvfp4WordsPerGroup + 1];
+        scale[c] = e4m3_to_float_scaled(s_row[c][g]);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) {
+          wv[c][j] = fp4_e2m1_to_float_scaled((w0 >> (4 * j)) & 0xFu);
+          wv[c][j + 8] = fp4_e2m1_to_float_scaled((w1 >> (4 * j)) & 0xFu);
+        }
+      }
+#pragma unroll
+      for (int t = 0; t < TOKENS; ++t) {
+        const T* xg = x_row[t] + g * kNvfp4GroupSize;
+        float xv[kNvfp4GroupSize];
+#pragma unroll
+        for (int j = 0; j < kNvfp4GroupSize; ++j) {
+          xv[j] = to_float(xg[j]);
+        }
+#pragma unroll
+        for (int c = 0; c < COLS; ++c) {
+          float qdot = 0.0f;
+#pragma unroll
+          for (int j = 0; j < kNvfp4GroupSize; ++j) {
+            qdot = fmaf(xv[j], wv[c][j], qdot);
+          }
+          acc[t][c] = fmaf(scale[c], qdot, acc[t][c]);
+        }
+      }
+    }
+#pragma unroll
+    for (int t = 0; t < TOKENS; ++t) {
+#pragma unroll
+      for (int c = 0; c < COLS; ++c) {
+        float v = acc[t][c];
+#pragma unroll
+        for (int offset = kNvfp4LanesPerCol / 2; offset > 0; offset /= 2) {
+          v += __shfl_xor(v, offset, kNvfp4LanesPerCol);
+        }
+        if (lane == 0 && t < count && c < ncols) {
+          out[static_cast<int64_t>(b0 + t) * N + col0 + c] =
+              from_float<T>(v * factor);
+        }
+      }
+    }
+  }
+}
+
+// ======================================================================
+// mlxcelverse: rocWMMA tile variant of the expert-batched NVFP4 gather for a
+// sorted prefill (lablup/mlxcel#2698).
+//
+// Same routing as nvfp4_gather_expert_batched_kernel: block z is expert z,
+// whose run of the sorted rhs indices find_sorted_expert_run locates, and
+// block z == E zeroes the rows routed at or past E. The products go through
+// 16x16x16 rocWMMA tiles instead of per-lane FMAs: each K step of 64 (four
+// NVFP4 groups) gathers BM activation rows into shared memory once for the
+// whole block, and each of the four 32-lane warps dequantizes a 32-column slab
+// of the weight tile into T (e2m1 * e4m3 has at most six significant bits
+// and stays inside fp16's normal range, so the dequantized value is exact in
+// fp16 and bf16, as in nvfp4_dequantize_dense) and multiplies it into MT x 2 accumulator tiles in
+// f32. The global scale enters each output once, at the store.
+//
+// T is fp16 or bf16 (the fragment type); f32 activations keep the scalar
+// kernel. K % 64 == 0 so a K step never straddles a row, and each lane's
+// weight and scale loads are 16- and 4-byte aligned given aligned bases,
+// which the dispatch checks. Four warps of 32 lanes
+// each own a tile, so the dispatch launches this only on a wave32 device
+// (wmma_qmm_wavefront_ok), like qmm_wmma_dense_kernel.
+//
+// Grid: (row-tile slots, ceil(N / 128), E + 1); block x grid-strides over the
+// run's BM-row tiles. Block: 128 threads.
+// ======================================================================
+template <typename T, int MT>
+__global__ void __launch_bounds__(128) nvfp4_gather_expert_wmma_kernel(
+    const T* __restrict__ x,
+    const uint32_t* __restrict__ w,
+    const uint8_t* __restrict__ scales,
+    const float* __restrict__ global_scale,
+    const uint32_t* __restrict__ lhs_indices,
+    const uint32_t* __restrict__ rhs_indices, // SORTED
+    const rocm::Shape batch_shape,
+    const rocm::Strides lhs_idx_strides,
+    const rocm::Strides rhs_idx_strides,
+    int batch_ndim,
+    T* __restrict__ out,
+    int B,
+    int N,
+    int K,
+    int E) {
+#if ROCM_HAS_WMMA
+  constexpr int WM = 16, WN = 16, WK = 16;
+  constexpr int NT = 2;
+  constexpr int NWARP = 4;
+  constexpr int BM = WM * MT;
+  constexpr int BN_W = WN * NT; // 32 columns a warp, one per lane
+  constexpr int BN = BN_W * NWARP; // 128 columns a block
+  constexpr int BK = 64; // four NVFP4 groups
+  constexpr int GPT = BK / kNvfp4GroupSize; // groups per K step
+  constexpr int CH = BK * sizeof(T) / 16; // uint4 chunks per activation row
+  constexpr int AB_BYTES = (BM * BK + BK * BN) * sizeof(T);
+  constexpr int C_BYTES = BM * BN * sizeof(float);
+  constexpr int SMEM_BYTES = AB_BYTES > C_BYTES ? AB_BYTES : C_BYTES;
+
+  // The gathered activations and the weight tile are dead once the K loop
+  // ends, so the f32 output tile reuses their storage.
+  __shared__ __align__(16) unsigned char smem[SMEM_BYTES];
+  T(*sX)[BK] = reinterpret_cast<T(*)[BK]>(smem);
+  T(*sB)[BN] = reinterpret_cast<T(*)[BN]>(smem + BM * BK * sizeof(T));
+  float(*sC)[BN] = reinterpret_cast<float(*)[BN]>(smem);
+  __shared__ int s_xrow[BM];
+  __shared__ int s_run_start, s_run_end;
+
+  const int tid = threadIdx.x;
+  const int warp = tid >> 5;
+  const int lane = tid & 31;
+  const uint32_t expert = blockIdx.z;
+  const int n0 = blockIdx.y * BN;
+
+  if (tid == 0) {
+    int rs, re;
+    find_sorted_expert_run(
+        rhs_indices, batch_shape, rhs_idx_strides, batch_ndim, B, expert, rs,
+        re);
+    s_run_start = rs;
+    // Block E takes every row whose expert is E or larger.
+    s_run_end = expert < static_cast<uint32_t>(E) ? re : B;
+  }
+  __syncthreads();
+  const int run_start = s_run_start;
+  const int run_len = s_run_end - s_run_start;
+  if (run_len <= 0 || n0 >= N) {
+    return;
+  }
+  if (expert >= static_cast<uint32_t>(E)) {
+    for (int r = blockIdx.x; r < run_len; r += gridDim.x) {
+      for (int c = tid; c < BN && n0 + c < N; c += blockDim.x) {
+        out[static_cast<int64_t>(run_start + r) * N + n0 + c] =
+            from_float<T>(0.0f);
+      }
+    }
+    return;
+  }
+
+  using frag_a =
+      rocwmma::fragment<rocwmma::matrix_a, WM, WN, WK, T, rocwmma::row_major>;
+  using frag_b =
+      rocwmma::fragment<rocwmma::matrix_b, WM, WN, WK, T, rocwmma::row_major>;
+  using frag_acc = rocwmma::fragment<rocwmma::accumulator, WM, WN, WK, float>;
+
+  const int64_t words_per_row = K / 8;
+  const int64_t groups_per_row = K / kNvfp4GroupSize;
+  // This lane's weight column; past N it dequantizes zeros and reads nothing.
+  const int col = warp * BN_W + lane;
+  const int n = n0 + col;
+  const bool col_ok = n < N;
+  const uint32_t* w_col = w +
+      (static_cast<int64_t>(expert) * N + (col_ok ? n : 0)) * words_per_row;
+  const uint8_t* s_col = scales +
+      (static_cast<int64_t>(expert) * N + (col_ok ? n : 0)) * groups_per_row;
+  const float unscale = kFp4HalfBitsScale * kE4m3HalfBitsScale;
+  const float factor = global_scale
+      ? global_scale[expert] / kNvfp4GlobalScaleDenom
+      : 1.0f;
+
+  for (int row0 = blockIdx.x * BM; row0 < run_len; row0 += gridDim.x * BM) {
+    if (tid < BM) {
+      const int r = row0 + tid;
+      // Rows past the run read the run's first row; they are not stored.
+      const int b = run_start + (r < run_len ? r : 0);
+      s_xrow[tid] = static_cast<int>(lhs_indices[gather_index_loc(
+          b, batch_shape, lhs_idx_strides, batch_ndim)]);
+    }
+    __syncthreads();
+
+    frag_acc cf[MT][NT];
+#pragma unroll
+    for (int mt = 0; mt < MT; ++mt) {
+#pragma unroll
+      for (int t = 0; t < NT; ++t) {
+        rocwmma::fill_fragment(cf[mt][t], 0.0f);
+      }
+    }
+
+    for (int kk = 0; kk < K; kk += BK) {
+      for (int idx = tid; idx < BM * CH; idx += NWARP * 32) {
+        const int r = idx / CH, ch = idx % CH;
+        *reinterpret_cast<uint4*>(&sX[r][ch * (16 / sizeof(T))]) =
+            *reinterpret_cast<const uint4*>(
+                x + static_cast<int64_t>(s_xrow[r]) * K + kk +
+                ch * (16 / sizeof(T)));
+      }
+      if (col_ok) {
+        const uint4 wa = *reinterpret_cast<const uint4*>(w_col + kk / 8);
+        const uint4 wb = *reinterpret_cast<const uint4*>(w_col + kk / 8 + 4);
+        const uint32_t sq = *reinterpret_cast<const uint32_t*>(
+            s_col + kk / kNvfp4GroupSize);
+        const uint32_t words[8] = {
+            wa.x, wa.y, wa.z, wa.w, wb.x, wb.y, wb.z, wb.w};
+#pragma unroll
+        for (int g = 0; g < GPT; ++g) {
+          const float s =
+              e4m3_to_float_scaled(static_cast<uint8_t>(sq >> (8 * g))) *
+              unscale;
+#pragma unroll
+          for (int h = 0; h < kNvfp4WordsPerGroup; ++h) {
+            const uint32_t wd = words[g * kNvfp4WordsPerGroup + h];
+#pragma unroll
+            for (int j = 0; j < 8; ++j) {
+              sB[g * kNvfp4GroupSize + h * 8 + j][col] = from_float<T>(
+                  fp4_e2m1_to_float_scaled((wd >> (4 * j)) & 0xFu) * s);
+            }
+          }
+        }
+      } else {
+#pragma unroll
+        for (int k = 0; k < BK; ++k) {
+          sB[k][col] = from_float<T>(0.0f);
+        }
+      }
+      __syncthreads();
+#pragma unroll
+      for (int ks = 0; ks < BK; ks += WK) {
+        frag_a af[MT];
+#pragma unroll
+        for (int mt = 0; mt < MT; ++mt) {
+          rocwmma::load_matrix_sync(af[mt], &sX[mt * WM][ks], BK);
+        }
+#pragma unroll
+        for (int t = 0; t < NT; ++t) {
+          frag_b bf;
+          rocwmma::load_matrix_sync(bf, &sB[ks][warp * BN_W + t * WN], BN);
+#pragma unroll
+          for (int mt = 0; mt < MT; ++mt) {
+            rocwmma::mma_sync(cf[mt][t], af[mt], bf, cf[mt][t]);
+          }
+        }
+      }
+      __syncthreads();
+    }
+
+#pragma unroll
+    for (int mt = 0; mt < MT; ++mt) {
+#pragma unroll
+      for (int t = 0; t < NT; ++t) {
+        rocwmma::store_matrix_sync(
+            &sC[mt * WM][warp * BN_W + t * WN],
+            cf[mt][t],
+            BN,
+            rocwmma::mem_row_major);
+      }
+    }
+    __syncthreads();
+    for (int idx = tid; idx < BM * BN; idx += NWARP * 32) {
+      const int r = idx / BN, c = idx % BN;
+      if (row0 + r < run_len && n0 + c < N) {
+        out[static_cast<int64_t>(run_start + row0 + r) * N + n0 + c] =
+            from_float<T>(sC[r][c] * factor);
+      }
+    }
+    // sC aliases sX and sB, and s_xrow is rewritten: every thread finishes
+    // reading before the next tile starts writing.
+    __syncthreads();
+  }
+#endif // ROCM_HAS_WMMA
+}
+
+// int8 integer-dot gather expert QMV (4-bit affine, decode). Activation already
+// quantized to int8 (xpack even/odd + per-group scale dxq + sum sxq) by a
+// prepass; expert weight nibbles fed to v_dot4_i32_iu8. Same run-find as the
+// fp32 expert kernel; only the inner matmul changes. THREADS_PER_COL = 32.
+// Not launched from GatherQMM::eval_gpu; it takes the same strided index reads
+// as gather_qmv_expert_batched_kernel so it cannot regain that defect if it
+// is wired up.
+template <typename T, typename ScaleT, int GROUP_SIZE>
+__global__ void __launch_bounds__(1024) gather_qmv_idot_expert_batched_kernel(
+    const int32_t* __restrict__ xpack,
+    const uint8_t* __restrict__ w,
+    const ScaleT* __restrict__ scales,
+    const ScaleT* __restrict__ biases,
+    const float* __restrict__ dxq,
+    const float* __restrict__ sxq,
+    const uint32_t* __restrict__ lhs_indices,
+    const uint32_t* __restrict__ rhs_indices,
+    const rocm::Shape batch_shape,
+    const rocm::Strides lhs_idx_strides,
+    const rocm::Strides rhs_idx_strides,
+    int batch_ndim,
+    T* __restrict__ out,
+    int B,
+    int M,
+    int N,
+    int K,
+    int E,
+    bool has_bias,
+    bool implicit_lhs,
+    int64_t implicit_x_batch_stride) {
+  const int lane = threadIdx.x;
+  const int warp_idx = threadIdx.y;
+  const int col = blockIdx.y * blockDim.y + warp_idx;
+  const int row = blockIdx.x;
+  const uint32_t expert_id = blockIdx.z;  // grid z = E, as for the fp kernel
+
+  __shared__ int s_run_start, s_run_end;
+  if (lane == 0 && warp_idx == 0) {
+    int rs, re;
+    find_sorted_expert_run(
+        rhs_indices, batch_shape, rhs_idx_strides, batch_ndim, B, expert_id,
+        rs, re);
+    s_run_start = rs;
+    s_run_end = re;
+  }
+  __syncthreads();
+  const int run_start = s_run_start;
+  const int run_end = s_run_end;
+  if (row >= M || col >= N)
+    return;
+  if (run_end <= run_start)
+    return;
+  if (expert_id >= static_cast<uint32_t>(E))
+    return;
+
+  const int num_groups = (K + GROUP_SIZE - 1) / GROUP_SIZE;
+  const int row_bytes = (K * 4 + 7) / 8;
+  const int wpg = GROUP_SIZE / 8;
+  const int nwords = K / 8;
+  int64_t w_expert_stride = static_cast<int64_t>(N) * row_bytes;
+  int64_t sb_expert_stride = static_cast<int64_t>(N) * num_groups;
+  const uint32_t* wr = reinterpret_cast<const uint32_t*>(
+      w + static_cast<int64_t>(expert_id) * w_expert_stride +
+      static_cast<int64_t>(col) * row_bytes);
+  const ScaleT* scales_row = scales +
+      static_cast<int64_t>(expert_id) * sb_expert_stride +
+      static_cast<int64_t>(col) * num_groups;
+  const ScaleT* biases_row = has_bias
+      ? (biases + static_cast<int64_t>(expert_id) * sb_expert_stride +
+         static_cast<int64_t>(col) * num_groups)
+      : nullptr;
+
+  int64_t x_batch_stride = static_cast<int64_t>(M) * K;
+  for (int b = run_start; b < run_end; ++b) {
+    uint32_t lhs_idx = implicit_lhs
+        ? 0u
+        : lhs_indices[gather_index_loc(
+              b, batch_shape, lhs_idx_strides, batch_ndim)];
+    int64_t x_offset = implicit_lhs
+        ? (static_cast<int64_t>(b) * implicit_x_batch_stride)
+        : (static_cast<int64_t>(lhs_idx) * x_batch_stride);
+    int64_t arow = x_offset / K + row;
+    const int32_t* xpack_row = xpack + arow * nwords * 2;
+    const float* dxr = dxq + arow * num_groups;
+    const float* sxr = sxq + arow * num_groups;
+
+    float acc = 0.0f;
+    for (int g = 0; g < num_groups; ++g) {
+      float scale =
+          load_scale_value<ScaleT, GROUP_SIZE, true>(scales_row[g]);
+      float bias_val = has_bias ? static_cast<float>(biases_row[g]) : 0.0f;
+      int w0 = g * wpg, w1 = w0 + wpg;
+      int qsum = 0;
+      for (int wi = w0 + lane; wi < w1; wi += 32) {
+        uint32_t vui = wr[wi];
+        int ew = vui & 0x0F0F0F0F;
+        int ow = (vui >> 4) & 0x0F0F0F0F;
+        qsum = sudot4_iu8(ew, xpack_row[2 * wi], qsum);
+        qsum = sudot4_iu8(ow, xpack_row[2 * wi + 1], qsum);
+      }
+      float qf = subgroup_reduce_sum_qmm<32>(static_cast<float>(qsum));
+      acc += scale * dxr[g] * qf + bias_val * sxr[g];
+    }
+    if (lane == 0)
+      out[static_cast<int64_t>(b) * M * N + static_cast<int64_t>(row) * N +
+          col] = static_cast<T>(acc);
+  }
+}
+
+// ======================================================================
+// Prefill-optimized gather QMV: groups batch elements by expert.
+//
+// For sorted rhs_indices, consecutive batch elements hit the same expert.
+// This kernel assigns blockIdx.z to contiguous runs of same-expert batches,
+// so all rows for one expert share weight reads from global memory.
+// Each block handles one column (via warp cooperation) and iterates over
+// all M rows for each batch element in the run.
+//
+// Grid: (num_runs, ceil(N/cols_per_block), max_rows_per_run)
+// Where num_runs = number of contiguous expert runs.
+// ======================================================================
+template <
+    typename T,
+    typename ScaleT,
+    int BITS,
+    int GROUP_SIZE,
+    bool AFFINE,
+    int THREADS_PER_COL>
+__global__ void __launch_bounds__(1024) gather_qmv_prefill_kernel(
+    const T* __restrict__ x,
+    const uint8_t* __restrict__ w,
+    const ScaleT* __restrict__ scales,
+    const ScaleT* __restrict__ biases,
+    const uint32_t* __restrict__ lhs_indices,
+    const uint32_t* __restrict__ rhs_indices,
+    const int* __restrict__ run_starts,   // [num_runs]: start batch idx of each run
+    const int* __restrict__ run_lengths,  // [num_runs]: length of each run
+    const int* __restrict__ out_perm,     // [B]: sorted batch idx → original batch idx
+    T* __restrict__ out,
+    int B,
+    int M,
+    int N,
+    int K,
+    int E,
+    bool has_bias,
+    int64_t x_batch_stride) {
+  const int lane = threadIdx.x;
+  const int warp_idx = threadIdx.y;
+  const int col = blockIdx.y * blockDim.y + warp_idx;
+  const int run_id = blockIdx.z;
+  const int row = blockIdx.x;
+
+  if (row >= M || col >= N) return;
+
+  int run_start = run_starts[run_id];
+  int run_len = run_lengths[run_id];
+
+  // All batches in this run have the same expert
+  uint32_t rhs_idx = rhs_indices[run_start];
+  if (rhs_idx >= static_cast<uint32_t>(E)) return;
+
+  // Weight pointers (same for all batches in run)
+  const int num_groups = (K + GROUP_SIZE - 1) / GROUP_SIZE;
+  const int row_bytes = (K * BITS + 7) / 8;
+  int64_t w_expert_stride = static_cast<int64_t>(N) * row_bytes;
+  int64_t sb_expert_stride = static_cast<int64_t>(N) * num_groups;
+  int64_t col_w_offset = static_cast<int64_t>(col) * row_bytes;
+  int64_t col_sb_offset = static_cast<int64_t>(col) * num_groups;
+
+  const uint8_t* w_row = w + static_cast<int64_t>(rhs_idx) * w_expert_stride + col_w_offset;
+  const ScaleT* scales_row = scales + static_cast<int64_t>(rhs_idx) * sb_expert_stride + col_sb_offset;
+  const ScaleT* biases_row = has_bias
+      ? (biases + static_cast<int64_t>(rhs_idx) * sb_expert_stride + col_sb_offset)
+      : nullptr;
+
+  // Process each batch element in the run
+  for (int r = 0; r < run_len; ++r) {
+    int batch = run_start + r;
+    uint32_t lhs_idx = lhs_indices[batch];
+    const T* x_row = x + static_cast<int64_t>(lhs_idx) * x_batch_stride + static_cast<int64_t>(row) * K;
+
+    float acc = 0.0f;
+
+    for (int g = 0; g < num_groups; ++g) {
+      int k_start = g * GROUP_SIZE;
+      int k_end = min(k_start + GROUP_SIZE, K);
+
+      float scale = load_scale_value<ScaleT, GROUP_SIZE, AFFINE>(scales_row[g]);
+      float bias_val = has_bias ? static_cast<float>(biases_row[g]) : 0.0f;
+
+      if constexpr (AFFINE) {
+        float qx_acc = 0.0f;
+        float x_group_sum = 0.0f;
+
+        if constexpr (BITS == 4) {
+          int k_local = lane * 8;
+          int step = THREADS_PER_COL * 8;
+          for (; k_start + k_local + 7 < k_end; k_local += step) {
+            int k = k_start + k_local;
+            uint32_t w_packed = *reinterpret_cast<const uint32_t*>(&w_row[k / 2]);
+            float w0 = static_cast<float>(w_packed & 0xF);
+            float w1 = static_cast<float>((w_packed >> 4) & 0xF);
+            float w2 = static_cast<float>((w_packed >> 8) & 0xF);
+            float w3 = static_cast<float>((w_packed >> 12) & 0xF);
+            float w4 = static_cast<float>((w_packed >> 16) & 0xF);
+            float w5 = static_cast<float>((w_packed >> 20) & 0xF);
+            float w6 = static_cast<float>((w_packed >> 24) & 0xF);
+            float w7 = static_cast<float>((w_packed >> 28) & 0xF);
+            float x0 = static_cast<float>(x_row[k]);
+            float x1 = static_cast<float>(x_row[k + 1]);
+            float x2 = static_cast<float>(x_row[k + 2]);
+            float x3 = static_cast<float>(x_row[k + 3]);
+            float x4 = static_cast<float>(x_row[k + 4]);
+            float x5 = static_cast<float>(x_row[k + 5]);
+            float x6 = static_cast<float>(x_row[k + 6]);
+            float x7 = static_cast<float>(x_row[k + 7]);
+            qx_acc = fmaf(x0, w0, qx_acc);
+            qx_acc = fmaf(x1, w1, qx_acc);
+            qx_acc = fmaf(x2, w2, qx_acc);
+            qx_acc = fmaf(x3, w3, qx_acc);
+            qx_acc = fmaf(x4, w4, qx_acc);
+            qx_acc = fmaf(x5, w5, qx_acc);
+            qx_acc = fmaf(x6, w6, qx_acc);
+            qx_acc = fmaf(x7, w7, qx_acc);
+            if (has_bias)
+              x_group_sum += x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7;
+          }
+          for (; k_start + k_local < k_end; k_local++) {
+            int k = k_start + k_local;
+            float x_val = static_cast<float>(x_row[k]);
+            uint8_t quant_val = unpack_packed_value_fast<BITS>(w_row, k, row_bytes);
+            qx_acc = fmaf(x_val, static_cast<float>(quant_val), qx_acc);
+            if (has_bias) x_group_sum += x_val;
+          }
+        } else if constexpr (BITS == 8) {
+          int k_local = lane * 4;
+          int step = THREADS_PER_COL * 4;
+          for (; k_start + k_local + 3 < k_end; k_local += step) {
+            int k = k_start + k_local;
+            uint32_t w_packed = *reinterpret_cast<const uint32_t*>(&w_row[k]);
+            float w0 = static_cast<float>(w_packed & 0xFF);
+            float w1 = static_cast<float>((w_packed >> 8) & 0xFF);
+            float w2 = static_cast<float>((w_packed >> 16) & 0xFF);
+            float w3 = static_cast<float>((w_packed >> 24) & 0xFF);
+            float x0 = static_cast<float>(x_row[k]);
+            float x1 = static_cast<float>(x_row[k + 1]);
+            float x2 = static_cast<float>(x_row[k + 2]);
+            float x3 = static_cast<float>(x_row[k + 3]);
+            qx_acc = fmaf(x0, w0, qx_acc);
+            qx_acc = fmaf(x1, w1, qx_acc);
+            qx_acc = fmaf(x2, w2, qx_acc);
+            qx_acc = fmaf(x3, w3, qx_acc);
+            if (has_bias) x_group_sum += x0 + x1 + x2 + x3;
+          }
+          for (; k_start + k_local < k_end; k_local++) {
+            int k = k_start + k_local;
+            float x_val = static_cast<float>(x_row[k]);
+            float w_val = static_cast<float>(w_row[k]);
+            qx_acc = fmaf(x_val, w_val, qx_acc);
+            if (has_bias) x_group_sum += x_val;
+          }
+        } else {
+          for (int k_local = lane; k_start + k_local < k_end; k_local += THREADS_PER_COL) {
+            int k = k_start + k_local;
+            float x_val = static_cast<float>(x_row[k]);
+            uint8_t quant_val = unpack_packed_value_fast<BITS>(w_row, k, row_bytes);
+            qx_acc = fmaf(x_val, static_cast<float>(quant_val), qx_acc);
+            if (has_bias) x_group_sum += x_val;
+          }
+        }
+
+        qx_acc = subgroup_reduce_sum_qmm<THREADS_PER_COL>(qx_acc);
+        x_group_sum = subgroup_reduce_sum_qmm<THREADS_PER_COL>(x_group_sum);
+        acc += scale * qx_acc + bias_val * x_group_sum;
+      } else {
+        float qx_acc = 0.0f;
+        for (int k_local = lane; k_start + k_local < k_end; k_local += THREADS_PER_COL) {
+          int k = k_start + k_local;
+          float x_val = static_cast<float>(x_row[k]);
+          uint8_t quant_val = unpack_packed_value_fast<BITS>(w_row, k, row_bytes);
+          qx_acc = fmaf(x_val, dequantize_value<BITS, false>(quant_val, 1.0f, 0.0f), qx_acc);
+        }
+        acc += scale * subgroup_reduce_sum_qmm<THREADS_PER_COL>(qx_acc);
+      }
+    }
+
+    if (lane == 0) {
+      const int orig_batch = out_perm[batch];
+      out[static_cast<int64_t>(orig_batch) * M * N + static_cast<int64_t>(row) * N + col] = static_cast<T>(acc);
+    }
+  }
+}
+
+template <
+    typename T,
+    typename ScaleT,
+    int BITS,
+    int GROUP_SIZE,
+    bool AFFINE,
+    int THREADS_PER_COL>
+__global__ void __launch_bounds__(1024) gather_qmv_warp_shared_kernel(
+    const T* __restrict__ x,
+    const uint8_t* __restrict__ w,
+    const ScaleT* __restrict__ scales,
+    const ScaleT* __restrict__ biases,
+    const uint32_t* __restrict__ lhs_indices,
+    const uint32_t* __restrict__ rhs_indices,
+    const rocm::Shape batch_shape,
+    const rocm::Strides lhs_idx_strides,
+    const rocm::Strides rhs_idx_strides,
+    int batch_ndim,
+    T* __restrict__ out,
+    int B,
+    int M,
+    int N,
+    int K,
+    int E,
+    bool has_bias,
+    bool implicit_lhs = false,
+    int64_t implicit_x_batch_stride = 0) {
+  const int lane = threadIdx.x;
+  const int warp_idx = threadIdx.y;
+  const int col = blockIdx.y * blockDim.y + warp_idx;
+  const int row = blockIdx.x;
+  const int batch = blockIdx.z;
+
+  if (batch >= B || row >= M) {
+    return;
+  }
+
+  int64_t rhs_idx_loc = 0;
+  int64_t lhs_idx_loc = 0;
+  if (batch_ndim == 1) {
+    rhs_idx_loc = static_cast<int64_t>(batch) * rhs_idx_strides[0];
+    if (!implicit_lhs) {
+      lhs_idx_loc = static_cast<int64_t>(batch) * lhs_idx_strides[0];
+    }
+  } else if (batch_ndim > 1) {
+    int64_t elem = static_cast<int64_t>(batch);
+    for (int i = batch_ndim - 1; i >= 0; --i) {
+      int64_t coord = elem % batch_shape.data_[i];
+      rhs_idx_loc += coord * rhs_idx_strides.data_[i];
+      if (!implicit_lhs) {
+        lhs_idx_loc += coord * lhs_idx_strides.data_[i];
+      }
+      elem /= batch_shape.data_[i];
+    }
+  }
+
+  uint32_t lhs_idx = implicit_lhs ? 0u : lhs_indices[lhs_idx_loc];
+  uint32_t rhs_idx = rhs_indices[rhs_idx_loc];
+
+  const bool col_valid = col < N;
+  const bool expert_valid = rhs_idx < static_cast<uint32_t>(E);
+  const bool valid = col_valid && expert_valid;
+
+  const int num_groups = (K + GROUP_SIZE - 1) / GROUP_SIZE;
+  const int row_bytes = (K * BITS + 7) / 8;
+
+  int64_t x_batch_stride = static_cast<int64_t>(M) * K;
+  int64_t w_batch_stride = static_cast<int64_t>(N) * row_bytes;
+  int64_t sb_batch_stride = static_cast<int64_t>(N) * num_groups;
+  int64_t col_w_offset = static_cast<int64_t>(col) * row_bytes;
+  int64_t col_sb_offset = static_cast<int64_t>(col) * num_groups;
+
+  int64_t x_batch_offset = implicit_lhs
+      ? (static_cast<int64_t>(batch) * implicit_x_batch_stride)
+      : (static_cast<int64_t>(lhs_idx) * x_batch_stride);
+  const T* x_row = x + x_batch_offset + static_cast<int64_t>(row) * K;
+  const uint8_t* w_row = valid
+      ? (w + static_cast<int64_t>(rhs_idx) * w_batch_stride + col_w_offset)
+      : nullptr;
+  const ScaleT* scales_row = valid
+      ? (scales + static_cast<int64_t>(rhs_idx) * sb_batch_stride +
+         col_sb_offset)
+      : nullptr;
+  const ScaleT* biases_row = (valid && has_bias)
+      ? (biases + static_cast<int64_t>(rhs_idx) * sb_batch_stride +
+         col_sb_offset)
+      : nullptr;
+
+  float acc = 0.0f;
+
+  constexpr int CHUNK_SIZE = 2048;
+  __shared__ float shared_x[CHUNK_SIZE];
+
+  for (int chunk_start = 0; chunk_start < K; chunk_start += CHUNK_SIZE) {
+    int chunk_end = min(chunk_start + CHUNK_SIZE, K);
+    int chunk_len = chunk_end - chunk_start;
+
+    int tid = warp_idx * blockDim.x + lane;
+    for (int i = tid; i < chunk_len; i += blockDim.x * blockDim.y) {
+      shared_x[i] = static_cast<float>(x_row[chunk_start + i]);
+    }
+    __syncthreads();
+
+    // mlxcelverse: mxfp4 (4-bit e2m1, group size 32, one E8M0 scale byte per
+    // group, no biases) walks packed words across the whole chunk instead of
+    // looping per group. With the per-group loop below, lanes start at
+    // lane * 8 inside each 32-value group, so only lanes 0 to 3 of 16 did work
+    // and the decode went through the branchy fp4_e2m1_to_float switch. Here
+    // every lane takes one 8-value word per step: the word's eight nibbles
+    // sit in one group (8 divides 32), so each word reads one scale, decodes
+    // without a branch (fp4_e2m1_to_float_scaled, the value times 2^-14) and
+    // scales its dot product back by 2^14, as the expert-batched kernel does
+    // (LOCAL_FIXES.md item 31). The dispatch sends only K % 32 == 0 here, and
+    // CHUNK_SIZE is a multiple of 32, so no word straddles a chunk end.
+    constexpr bool kMxfp4WordPath = !AFFINE && BITS == 4 && GROUP_SIZE == 32;
+    if constexpr (kMxfp4WordPath) {
+      if (valid) {
+        for (int k = chunk_start + lane * 8; k < chunk_end;
+             k += THREADS_PER_COL * 8) {
+          const uint32_t packed =
+              *reinterpret_cast<const uint32_t*>(&w_row[k / 2]);
+          const float scale = load_scale_value<ScaleT, GROUP_SIZE, false>(
+              scales_row[k / GROUP_SIZE]);
+          const float* xs = &shared_x[k - chunk_start];
+          float qx = 0.0f;
+#pragma unroll
+          for (int j = 0; j < 8; ++j) {
+            qx = fmaf(
+                xs[j], fp4_e2m1_to_float_scaled((packed >> (4 * j)) & 0xFu), qx);
+          }
+          acc = fmaf(scale, qx * kFp4HalfBitsScale, acc);
+        }
+      }
+    }
+
+    if (!kMxfp4WordPath && valid) {
+      int g_start = chunk_start / GROUP_SIZE;
+      int g_end = (chunk_end + GROUP_SIZE - 1) / GROUP_SIZE;
+
+      for (int g = g_start; g < g_end; ++g) {
+        int k_start = max(g * GROUP_SIZE, chunk_start);
+        int k_end_g = min((g + 1) * GROUP_SIZE, chunk_end);
+
+        float scale =
+            load_scale_value<ScaleT, GROUP_SIZE, AFFINE>(scales_row[g]);
+        float bias_val = has_bias ? static_cast<float>(biases_row[g]) : 0.0f;
+
+        if constexpr (AFFINE) {
+          float qx_acc0 = 0.0f;
+          float qx_acc1 = 0.0f;
+          float qx_acc2 = 0.0f;
+          float qx_acc3 = 0.0f;
+          float x_group_sum = 0.0f;
+          float qx_acc = 0.0f;
+
+          if constexpr (BITS == 8) {
+            int k_local = lane * 4;
+            int step = THREADS_PER_COL * 4;
+            for (; k_start + k_local + 3 < k_end_g; k_local += step) {
+              int k = k_start + k_local;
+
+              uint32_t w_packed = *reinterpret_cast<const uint32_t*>(&w_row[k]);
+              float w0 = static_cast<float>(w_packed & 0xFF);
+              float w1 = static_cast<float>((w_packed >> 8) & 0xFF);
+              float w2 = static_cast<float>((w_packed >> 16) & 0xFF);
+              float w3 = static_cast<float>((w_packed >> 24) & 0xFF);
+
+              float x0 = shared_x[k - chunk_start];
+              float x1 = shared_x[k - chunk_start + 1];
+              float x2 = shared_x[k - chunk_start + 2];
+              float x3 = shared_x[k - chunk_start + 3];
+
+              qx_acc0 = fmaf(x0, w0, qx_acc0);
+              qx_acc1 = fmaf(x1, w1, qx_acc1);
+              qx_acc2 = fmaf(x2, w2, qx_acc2);
+              qx_acc3 = fmaf(x3, w3, qx_acc3);
+
+              if (has_bias) {
+                x_group_sum += x0 + x1 + x2 + x3;
+              }
+            }
+            qx_acc = qx_acc0 + qx_acc1 + qx_acc2 + qx_acc3;
+            for (; k_start + k_local < k_end_g; k_local++) {
+              int k = k_start + k_local;
+              float x_val = shared_x[k - chunk_start];
+              float w_val = static_cast<float>(w_row[k]);
+              qx_acc = fmaf(x_val, w_val, qx_acc);
+              if (has_bias) {
+                x_group_sum += x_val;
+              }
+            }
+          } else if constexpr (BITS == 4) {
+            int k_local = lane * 8;
+            int step = THREADS_PER_COL * 8;
+            for (; k_start + k_local + 7 < k_end_g; k_local += step) {
+              int k = k_start + k_local;
+              uint32_t w_packed =
+                  *reinterpret_cast<const uint32_t*>(&w_row[k / 2]);
+              float w0 = static_cast<float>(w_packed & 0xF);
+              float w1 = static_cast<float>((w_packed >> 4) & 0xF);
+              float w2 = static_cast<float>((w_packed >> 8) & 0xF);
+              float w3 = static_cast<float>((w_packed >> 12) & 0xF);
+              float w4 = static_cast<float>((w_packed >> 16) & 0xF);
+              float w5 = static_cast<float>((w_packed >> 20) & 0xF);
+              float w6 = static_cast<float>((w_packed >> 24) & 0xF);
+              float w7 = static_cast<float>((w_packed >> 28) & 0xF);
+              float x0 = shared_x[k - chunk_start];
+              float x1 = shared_x[k - chunk_start + 1];
+              float x2 = shared_x[k - chunk_start + 2];
+              float x3 = shared_x[k - chunk_start + 3];
+              float x4 = shared_x[k - chunk_start + 4];
+              float x5 = shared_x[k - chunk_start + 5];
+              float x6 = shared_x[k - chunk_start + 6];
+              float x7 = shared_x[k - chunk_start + 7];
+              // Four independent accumulators for RDNA4 dual-issue (mirrors the
+              // 8-bit branch); reassociated at group end.
+              qx_acc0 = fmaf(x0, w0, qx_acc0);
+              qx_acc1 = fmaf(x1, w1, qx_acc1);
+              qx_acc2 = fmaf(x2, w2, qx_acc2);
+              qx_acc3 = fmaf(x3, w3, qx_acc3);
+              qx_acc0 = fmaf(x4, w4, qx_acc0);
+              qx_acc1 = fmaf(x5, w5, qx_acc1);
+              qx_acc2 = fmaf(x6, w6, qx_acc2);
+              qx_acc3 = fmaf(x7, w7, qx_acc3);
+              if (has_bias) {
+                x_group_sum += x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7;
+              }
+            }
+            qx_acc = qx_acc0 + qx_acc1 + qx_acc2 + qx_acc3;
+            for (; k_start + k_local < k_end_g; k_local++) {
+              int k = k_start + k_local;
+              float x_val = shared_x[k - chunk_start];
+              uint8_t quant_val =
+                  unpack_packed_value_fast<BITS>(w_row, k, row_bytes);
+              qx_acc = fmaf(x_val, static_cast<float>(quant_val), qx_acc);
