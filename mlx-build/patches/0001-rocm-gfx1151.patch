index 0000000..1537c3a
--- /dev/null
+++ b/mlx/backend/rocm/allocator.h
@@ -0,0 +1,249 @@
+// Copyright © 2025 Apple Inc.
+//
+// ROCm allocator — mirrors mlx/backend/cuda/allocator.h exactly.
+// Device free/alloc: BufferCache recycle, hipMallocAsync / hipFreeAsync
+// (or hipMalloc / hipFree when no stream/pool). Only ROCm-specific extras
+// are host_shadow (discrete GPU CPU access) and optional decode arena /
+// graph deferred free.
+
+#pragma once
+
+#include "mlx/allocator.h"
+#include "mlx/backend/common/buffer_cache.h"
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace mlx::core::rocm {
+
+using allocator::Buffer;
+
+// Whether the CPU can dereference the unified-path device allocations
+// (hipMalloc, fine-grained) directly. Linux KFD maps them into the process
+// (APU UMA, large BAR), so `device == -1` buffers are read and written in
+// place. Windows WDDM does not map them, even on an APU: there every CPU access
+// goes through the host shadow (Buffer::raw_ptr) and gpu_ptr flushes CPU writes
+// back. Managed and pinned host memory would be CPU-visible on Windows, but
+// they are capped at the OS-visible RAM, while the UMA carve-out is device
+// memory (lablup/mlxcel#2601).
+constexpr bool device_memory_host_visible() {
+#ifdef _WIN32
+  return false;
+#else
+  return true;
+#endif
+}
+
+// Matches CudaBuffer + fields required for discrete-GPU host access and
+// stream-ordered free (CUDA uses move_to_unified_memory instead of shadow).
+// Field order is ABI-stable for brace-init sites outside this file
+// (e.g. gemms/naive_gemm.hip): data, size, is_managed, device, ...
+//
+// The shadow has two flags (lablup/mlxcel#2643). `host_dirty`: the shadow
+// holds CPU writes the device has not seen; gpu_ptr flushes it before a kernel
+// reads the buffer. `host_valid`: the shadow's bytes equal the device's as of
+// the last host access, so a read-only host access (rocm::host_read_ptr) can
+// use it without another device-to-host copy. A buffer whose shadow is neither
+// dirty nor valid is refreshed from the device on the next host access.
+// gpu_ptr clears `host_valid` because the kernel it serves may write the
+// buffer; a recycled buffer starts with both flags clear so its previous
+// owner's shadow is neither flushed nor served.
+struct RocmBuffer {
+  void* data;
+  size_t size;
+  bool is_managed;
+  int device; // -1 for unified / non-pool
+  void* host_shadow;
+  bool host_dirty;
+  void* alloc_stream; // stream used for hipMallocAsync / hipFreeAsync
+  // Appended last so a brace-init with the seven fields above still compiles
+  // and value-initializes this to false.
+  bool host_valid;
+};
+
+// ---------------------------------------------------------------------------
+// SmallSizePool — CUDA's 8-byte scalar freelist, with every slot on its own
+// cache line (see small_block_stride in allocator.cpp, lablup/mlxcel#2213).
+// ---------------------------------------------------------------------------
+
+class SmallSizePool {
+ private:
+  union Block {
+    Block* next;
+    RocmBuffer buf;
+  };
+
+  Block* buffer_{nullptr};
+  void* data_{nullptr};
+  bool data_managed_{true};
+  Block* next_free_{nullptr};
+
+ public:
+  SmallSizePool();
+  ~SmallSizePool();
+
+  SmallSizePool(const SmallSizePool&) = delete;
+  SmallSizePool& operator=(const SmallSizePool&) = delete;
+
+  RocmBuffer* malloc();
+  void free(RocmBuffer* buf);
+  bool in_pool(RocmBuffer* buf);
+};
+
+// ---------------------------------------------------------------------------
+// DecodeArena — optional bump allocator for HIP-graph decode (not in CUDA).
+// Training does not use this; only the graph-decode engine does.
+// ---------------------------------------------------------------------------
+struct DecodeArena {
+  void* base{nullptr};
+  size_t capacity{0};
+  size_t offset{0};
+  bool active{false};
+  bool overflowed{false};
+  int device{-1};
+  std::deque<RocmBuffer> wrappers;
+  size_t next_wrapper{0};
+  size_t high_water{0};
+  size_t floor_offset{0};
+  size_t floor_wrapper{0};
+
+  bool contains(const void* p) const {
+    return base && p >= base && p < static_cast<const char*>(base) + capacity;
+  }
+};
+
+// ---------------------------------------------------------------------------
+// RocmAllocator — same control flow as CudaAllocator.
+// ---------------------------------------------------------------------------
+
+class RocmAllocator : public allocator::Allocator {
+ public:
+  Buffer malloc(size_t size) override;
+  Buffer malloc_async(size_t size, int device, void* stream);
+  void free(Buffer buffer) override {
+    free(buffer, /*force=*/false);
+  }
+  void free(Buffer buffer, bool force);
+  size_t size(Buffer buffer) const override;
+
+  Buffer make_buffer(void* ptr, size_t size) override;
+  void release(Buffer buffer) override;
+
+  // Free device storage only (CUDA free_async).
+  void free_async(RocmBuffer& buf, void* stream = nullptr);
+  // Free device + delete shell (CUDA free_cuda_buffer).
+  void free_rocm_buffer(RocmBuffer* buf);
+
+  // Give `buf` a host shadow whose bytes match the device unless the shadow
+  // is dirty (then it is the authority). `for_write` marks the shadow dirty,
+  // because the caller will write through it; a read-only caller leaves it
+  // clean and valid. Throws when hipHostMalloc or the copy fails; the byte
+  // counter moves only on a successful allocation (lablup/mlxcel#2643).
+  void ensure_host_shadow(RocmBuffer& buf, bool for_write);
+  void flush_host_shadow(RocmBuffer& buf);
+  // Free the shadow, if any, and clear both flags. Every free path and the
+  // arena wrapper reuse go through here so the byte counter cannot drift.
+  void release_host_shadow(RocmBuffer& buf);
+
+  // Pinned bytes the live host shadows hold (the shadowed buffers' allocator
+  // sizes), and the process-wide device-to-host and host-to-device copy
+  // counts. Relaxed atomics: ensure_host_shadow runs without mutex_.
+  size_t get_host_shadow_memory() const {
+    return host_shadow_bytes_.load(std::memory_order_relaxed);
+  }
+  uint64_t host_shadow_downloads() const {
+    return host_shadow_downloads_.load(std::memory_order_relaxed);
+  }
+  uint64_t host_shadow_uploads() const {
+    return host_shadow_uploads_.load(std::memory_order_relaxed);
+  }
+
+  bool decode_arena_begin(size_t capacity, int device, void* stream);
+  void decode_arena_reset();
+  void decode_arena_freeze_floor();
+  void decode_arena_reset_to_floor();
+  void decode_arena_end();
+  bool decode_arena_active() const {
+    return decode_arena_.active;
+  }
+  size_t decode_arena_high_water() const {
+    return decode_arena_.high_water;
+  }
+  bool decode_arena_overflowed() const {
+    return decode_arena_.overflowed;
+  }
+
+  bool train_arena_begin(size_t capacity, int device, void* stream) {
+    return decode_arena_begin(capacity, device, stream);
+  }
+  void train_arena_reset() {
+    decode_arena_reset();
+  }
+  void train_arena_freeze_floor() {
+    decode_arena_freeze_floor();
+  }
+  void train_arena_reset_to_floor() {
+    decode_arena_reset_to_floor();
+  }
+  void train_arena_end() {
+    decode_arena_end();
+  }
+  bool train_arena_active() const {
+    return decode_arena_active();
+  }
+  size_t train_arena_high_water() const {
+    return decode_arena_high_water();
+  }
+  bool train_arena_overflowed() const {
+    return decode_arena_overflowed();
+  }
+
+  size_t get_active_memory() const;
+  size_t get_peak_memory() const;
+  void reset_peak_memory();
+  size_t get_memory_limit();
+  size_t set_memory_limit(size_t limit);
+  size_t get_cache_memory() const;
+  size_t set_cache_limit(size_t limit);
+  void clear_cache();
+
+ private:
+  RocmAllocator();
+  friend RocmAllocator& allocator();
+
+  RocmBuffer* arena_alloc(size_t size);
+
+  std::mutex mutex_;
+  size_t memory_limit_;
+  size_t free_limit_;
+  size_t total_memory_{0};
+  size_t max_pool_size_;
+  BufferCache<RocmBuffer> buffer_cache_;
+  size_t active_memory_{0};
+  size_t peak_memory_{0};
+  std::atomic<size_t> host_shadow_bytes_{0};
+  std::atomic<uint64_t> host_shadow_downloads_{0};
+  std::atomic<uint64_t> host_shadow_uploads_{0};
+  std::vector<void*> free_streams_;
+  std::vector<void*> mem_pools_;
+  SmallSizePool scalar_pool_;
+  DecodeArena decode_arena_;
+};
+
+RocmAllocator& allocator();
+
+// Bytes this thread has taken from RocmAllocator::malloc / malloc_async since
+// the thread started (cache hits included). Monotonic and thread-local, so a
+// caller can difference two reads around a primitive's eval_gpu and learn how
+// much new memory that primitive's outputs and scratch pinned, unaffected by
+// the worker thread freeing completed batches meanwhile (lablup/mlxcel#2062).
+size_t thread_allocated_bytes();
+
+class CommandEncoder;
+allocator::Data malloc_async(size_t size, CommandEncoder& encoder);
+
+} // namespace mlx::core::rocm
