+  hipblasOperation_t op_a = to_hipblas_op(transpose_b);
+  hipblasOperation_t op_b = to_hipblas_op(transpose_a);
+  // Host-mode scalars are read at enqueue; the parameters outlive the call.
+  hipblaslt_gemm_impl(
+      handle,
+      device_id,
+      op_a,
